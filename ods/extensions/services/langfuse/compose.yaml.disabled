services:
  langfuse:
    image: langfuse/langfuse:3.159.0
    container_name: ods-langfuse-web
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      HOSTNAME: "0.0.0.0"
      TELEMETRY_ENABLED: "false"
      NEXT_TELEMETRY_DISABLED: "1"
      DATABASE_URL: "postgresql://langfuse:${LANGFUSE_DB_PASSWORD}@langfuse-postgres:5432/langfuse"
      CLICKHOUSE_MIGRATION_URL: "clickhouse://langfuse-clickhouse:9000"
      CLICKHOUSE_URL: "http://langfuse-clickhouse:8123"
      CLICKHOUSE_USER: "langfuse"
      CLICKHOUSE_PASSWORD: "${LANGFUSE_CLICKHOUSE_PASSWORD}"
      REDIS_HOST: "langfuse-redis"
      REDIS_AUTH: "${LANGFUSE_REDIS_PASSWORD}"
      LANGFUSE_S3_EVENT_UPLOAD_ENABLED: "true"
      LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT: "http://langfuse-seaweedfs:8333"
      LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID: "${LANGFUSE_S3_ACCESS_KEY}"
      LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY: "${LANGFUSE_S3_SECRET_KEY}"
      LANGFUSE_S3_EVENT_UPLOAD_BUCKET: "langfuse-events"
      LANGFUSE_S3_EVENT_UPLOAD_REGION: "us-east-1"
      LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE: "true"
      CLICKHOUSE_CLUSTER_ENABLED: "false"
      NEXTAUTH_SECRET: "${LANGFUSE_NEXTAUTH_SECRET}"
      SALT: "${LANGFUSE_SALT}"
      ENCRYPTION_KEY: "${LANGFUSE_ENCRYPTION_KEY}"
      NEXTAUTH_URL: "http://localhost:${LANGFUSE_PORT:-3006}"
      LANGFUSE_INIT_ORG_ID: "ods"
      LANGFUSE_INIT_ORG_NAME: "ODS"
      LANGFUSE_INIT_PROJECT_ID: "${LANGFUSE_INIT_PROJECT_ID}"
      LANGFUSE_INIT_PROJECT_NAME: "ODS Traces"
      LANGFUSE_INIT_PROJECT_PUBLIC_KEY: "${LANGFUSE_PROJECT_PUBLIC_KEY}"
      LANGFUSE_INIT_PROJECT_SECRET_KEY: "${LANGFUSE_PROJECT_SECRET_KEY}"
      LANGFUSE_INIT_USER_EMAIL: "${LANGFUSE_INIT_USER_EMAIL:-admin@ods.local}"
      LANGFUSE_INIT_USER_NAME: "ODS Admin"
      LANGFUSE_INIT_USER_PASSWORD: "${LANGFUSE_INIT_USER_PASSWORD}"
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${LANGFUSE_PORT:-3006}:3000"
    networks:
      - default
      - langfuse-internal
    depends_on:
      langfuse-postgres:
        condition: service_healthy
      langfuse-clickhouse:
        condition: service_healthy
      langfuse-redis:
        condition: service_healthy
      langfuse-seaweedfs:
        condition: service_healthy
      langfuse-seaweedfs-init:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://127.0.0.1:3000/api/public/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1g
        reservations:
          cpus: '0.25'
          memory: 256m
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  langfuse-worker:
    image: langfuse/langfuse-worker:3.159.0
    container_name: ods-langfuse-worker
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      HOSTNAME: "0.0.0.0"
      DATABASE_URL: "postgresql://langfuse:${LANGFUSE_DB_PASSWORD}@langfuse-postgres:5432/langfuse"
      CLICKHOUSE_MIGRATION_URL: "clickhouse://langfuse-clickhouse:9000"
      CLICKHOUSE_URL: "http://langfuse-clickhouse:8123"
      CLICKHOUSE_USER: "langfuse"
      CLICKHOUSE_PASSWORD: "${LANGFUSE_CLICKHOUSE_PASSWORD}"
      REDIS_HOST: "langfuse-redis"
      REDIS_AUTH: "${LANGFUSE_REDIS_PASSWORD}"
      LANGFUSE_S3_EVENT_UPLOAD_ENABLED: "true"
      LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT: "http://langfuse-seaweedfs:8333"
      LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID: "${LANGFUSE_S3_ACCESS_KEY}"
      LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY: "${LANGFUSE_S3_SECRET_KEY}"
      LANGFUSE_S3_EVENT_UPLOAD_BUCKET: "langfuse-events"
      LANGFUSE_S3_EVENT_UPLOAD_REGION: "us-east-1"
      LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE: "true"
      CLICKHOUSE_CLUSTER_ENABLED: "false"
      SALT: "${LANGFUSE_SALT}"
      ENCRYPTION_KEY: "${LANGFUSE_ENCRYPTION_KEY}"
      TELEMETRY_ENABLED: "false"
      NEXT_TELEMETRY_DISABLED: "1"
    networks:
      - langfuse-internal
    depends_on:
      langfuse-postgres:
        condition: service_healthy
      langfuse-clickhouse:
        condition: service_healthy
      langfuse-redis:
        condition: service_healthy
      langfuse-seaweedfs:
        condition: service_healthy
      langfuse-seaweedfs-init:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://127.0.0.1:3030/api/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1g
        reservations:
          cpus: '0.25'
          memory: 256m
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  langfuse-postgres:
    image: postgres:17.9-alpine
    container_name: ods-langfuse-postgres
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      POSTGRES_USER: "langfuse"
      POSTGRES_PASSWORD: "${LANGFUSE_DB_PASSWORD}"
      POSTGRES_DB: "langfuse"
    volumes:
      - ./data/langfuse/postgres:/var/lib/postgresql/data
    networks:
      - langfuse-internal
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "langfuse"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 15s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512m
        reservations:
          cpus: '0.1'
          memory: 128m
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  langfuse-clickhouse:
    image: clickhouse/clickhouse-server:26.2.4.23
    container_name: ods-langfuse-clickhouse
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      CLICKHOUSE_USER: "langfuse"
      CLICKHOUSE_PASSWORD: "${LANGFUSE_CLICKHOUSE_PASSWORD}"
    volumes:
      - ./data/langfuse/clickhouse:/var/lib/clickhouse
    networks:
      - langfuse-internal
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:8123/ping"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 90s
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2g
        reservations:
          cpus: '0.5'
          memory: 256m
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  langfuse-redis:
    image: redis:7.4.8-alpine
    container_name: ods-langfuse-redis
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      LANGFUSE_REDIS_PASSWORD: "${LANGFUSE_REDIS_PASSWORD}"
    command: redis-server --requirepass ${LANGFUSE_REDIS_PASSWORD}
    volumes:
      - ./data/langfuse/redis:/data
    networks:
      - langfuse-internal
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a $${LANGFUSE_REDIS_PASSWORD} ping"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512m
        reservations:
          cpus: '0.1'
          memory: 64m
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  langfuse-seaweedfs:
    image: chrislusf/seaweedfs:4.47
    container_name: ods-langfuse-seaweedfs
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    command: >
      server -s3 -ip.bind=0.0.0.0
      -master.telemetry=false
      -s3.iam=false -s3.port.iceberg=0 -s3.port.lance=0
    environment:
      AWS_ACCESS_KEY_ID: "${LANGFUSE_S3_ACCESS_KEY}"
      AWS_SECRET_ACCESS_KEY: "${LANGFUSE_S3_SECRET_KEY}"
    volumes:
      - ./data/langfuse/seaweedfs:/data
    networks:
      - langfuse-internal
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://127.0.0.1:8333/status"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512m
        reservations:
          cpus: '0.1'
          memory: 128m
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  langfuse-seaweedfs-init:
    image: chrislusf/seaweedfs:4.47
    container_name: ods-langfuse-seaweedfs-init
    restart: "no"
    security_opt:
      - no-new-privileges:true
    entrypoint: /bin/sh
    command:
      - -c
      - |
        echo "s3.bucket.list" | weed shell -master=langfuse-seaweedfs:9333 | grep -q langfuse-events \
          || echo "s3.bucket.create -name langfuse-events" | weed shell -master=langfuse-seaweedfs:9333
        echo "Bucket langfuse-events ready"
    depends_on:
      langfuse-seaweedfs:
        condition: service_healthy
    networks:
      - langfuse-internal
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 128m
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # Inject Langfuse credentials into LiteLLM when this extension is active.
  # The callback itself is conditionally enabled by litellm's own entrypoint
  # based on LANGFUSE_ENABLED (already in .env, set by installer).
  litellm:
    environment:
      - LANGFUSE_PUBLIC_KEY=${LANGFUSE_PROJECT_PUBLIC_KEY:-}
      - LANGFUSE_SECRET_KEY=${LANGFUSE_PROJECT_SECRET_KEY:-}
      - LANGFUSE_HOST=http://langfuse:3000
      - LANGFUSE_TRACING_ENABLED=${LANGFUSE_ENABLED:-false}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

networks:
  langfuse-internal:
    internal: true
