[Unit]
Description=ODS Pixel socket directories for WSL Docker Desktop
ConditionVirtualization=wsl
Before=pixel-ingress.service pixel-workspace-preview.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/ods/pixel-agent.env
ExecStart=/usr/local/libexec/ods-pixel-wsl-runtime-bridge ensure
ExecStop=/usr/local/libexec/ods-pixel-wsl-runtime-bridge remove
TimeoutStartSec=20
TimeoutStopSec=20

[Install]
RequiredBy=pixel-ingress.service pixel-workspace-preview.service
