# Candidate project execution image; not wired into the Portal installer yet.
# Reuse the multi-platform Node digest already pinned by the ODS library.
FROM node:22-bookworm-slim@sha256:7af03b14a13c8cdd38e45058fd957bf00a72bbe17feac43b1c15a689c029c732
ENV HOME=/tmp/project-home \
    npm_config_cache=/tmp/npm-cache \
    npm_config_update_notifier=false \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
USER node
ENTRYPOINT []
CMD ["node", "--version"]
