{
  "id": "pixel-ods",
  "name": "Pixel ODS Integration",
  "description": "ODS status, delegated Perplexica research, guarded public-page evidence, verified downloads, and isolated workspace previews for Pixel.",
  "version": "1.0.0",
  "providers": ["ods-policy"],
  "contracts": {
    "tools": [
      "pixel_ods_status",
      "pixel_ods_apps_list",
      "pixel_ods_extensions",
      "pixel_ods_host_observe",
      "pixel_ods_host_command_propose",
      "pixel_ods_evidence_report",
      "pixel_ods_evidence_readback",
      "pixel_ods_web_extract",
      "pixel_ods_download_promote",
      "pixel_ods_workspace_preview",
      "pixel_ods_research"
    ]
  },
  "toolMetadata": {
    "pixel_ods_status": {
      "replaySafe": true
    },
    "pixel_ods_apps_list": {
      "replaySafe": true
    },
    "pixel_ods_extensions": {
      "replaySafe": true
    },
    "pixel_ods_host_observe": {
      "replaySafe": true
    }
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "managedProvider": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "activationId", "revision", "allowCloud"],
        "properties": {
          "schemaVersion": {"const": 1},
          "activationId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "allowCloud": {"type": "boolean"}
        }
      },
      "modelContextWindow": {
        "type": "integer",
        "minimum": 4096
      },
      "leanPrompt": {
        "type": "boolean"
      },
      "perplexicaPort": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    }
  }
}
