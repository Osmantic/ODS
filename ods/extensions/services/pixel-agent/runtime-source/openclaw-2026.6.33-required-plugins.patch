diff --git a/src/gateway/server-channels.required-plugins.test.ts b/src/gateway/server-channels.required-plugins.test.ts
new file mode 100644
index 00000000..15341df2
--- /dev/null
+++ b/src/gateway/server-channels.required-plugins.test.ts
@@ -0,0 +1,223 @@
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import type { ChannelId, ChannelPlugin } from "../channels/plugins/types.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { SubsystemLogger } from "../logging/subsystem.js";
+import type { RuntimeEnv } from "../runtime.js";
+
+let channels: typeof import("./server-channels.js");
+let health: typeof import("./channel-health-monitor.js");
+let hooks: typeof import("../plugins/hook-runner-global.js");
+let runtime: typeof import("../plugins/runtime.js");
+let required: typeof import("../plugins/required-plugins.js");
+let empty: typeof import("../plugins/registry-empty.js");
+let records: typeof import("../plugins/status.test-helpers.js");
+let logging: typeof import("../logging/subsystem.js");
+const managers: Array<ReturnType<typeof channels.createChannelManager>> = [];
+const monitors: Array<ReturnType<typeof health.startChannelHealthMonitor>> = [];
+const config: OpenClawConfig = {
+  plugins: { entries: { guard: { enabled: true, hooks: { allowConversationAccess: true } } } },
+};
+
+beforeAll(async () => {
+  vi.resetModules();
+  vi.stubEnv(
+    "OPENCLAW_REQUIRED_PLUGINS",
+    JSON.stringify({
+      version: 1,
+      plugins: [{ id: "guard", hooks: ["before_agent_run"] }],
+    }),
+  );
+  [channels, health, hooks, runtime, required, empty, records, logging] = await Promise.all([
+    import("./server-channels.js"),
+    import("./channel-health-monitor.js"),
+    import("../plugins/hook-runner-global.js"),
+    import("../plugins/runtime.js"),
+    import("../plugins/required-plugins.js"),
+    import("../plugins/registry-empty.js"),
+    import("../plugins/status.test-helpers.js"),
+    import("../logging/subsystem.js"),
+  ]);
+});
+afterEach(async () => {
+  for (const monitor of monitors.splice(0)) {
+    monitor.stop();
+  }
+  const stops = managers.splice(0).map((manager) => manager.stopChannel("discord"));
+  await vi.advanceTimersByTimeAsync(6000);
+  await Promise.all(stops);
+  vi.clearAllTimers();
+  vi.useRealTimers();
+  hooks.resetGlobalHookRunner();
+  runtime.resetPluginRuntimeStateForTest();
+});
+afterAll(() => {
+  vi.unstubAllEnvs();
+  vi.resetModules();
+});
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+
+function fixture(
+  options: {
+    isConfigured?: () => Promise<boolean>;
+    deferStartupAccountStartsUntil?: Promise<void>;
+    startupTrace?: Parameters<typeof channels.createChannelManager>[0]["startupTrace"];
+  } = {},
+) {
+  vi.useFakeTimers();
+  const startAccount = vi.fn(
+    ({ abortSignal }: { abortSignal: AbortSignal }) =>
+      new Promise<void>((resolve) => {
+        abortSignal.addEventListener("abort", () => resolve(), { once: true });
+      }),
+  );
+  const plugin: ChannelPlugin = {
+    id: "discord",
+    meta: {
+      id: "discord",
+      label: "Fixture",
+      selectionLabel: "Fixture",
+      docsPath: "/fixture",
+      blurb: "fixture",
+    },
+    capabilities: { chatTypes: ["direct"] },
+    config: {
+      listAccountIds: () => ["default"],
+      resolveAccount: () => ({ enabled: true }),
+      isEnabled: () => true,
+      describeAccount: () => ({ accountId: "default", configured: true, enabled: true }),
+      ...(options.isConfigured ? { isConfigured: options.isConfigured } : {}),
+    },
+    gateway: { startAccount },
+  };
+  const registry = empty.createEmptyPluginRegistry();
+  registry.channels.push({ pluginId: "fixture-channel", source: "fixture", plugin });
+  registry.plugins.push(records.createPluginRecord({ id: "guard" }));
+  registry.typedHooks.push({
+    pluginId: "guard",
+    hookName: "before_agent_run",
+    handler: () => undefined,
+    source: "fixture",
+  });
+  runtime.setActivePluginRegistry(registry);
+  hooks.initializeGlobalHookRunner(registry);
+  const ready = () =>
+    required.completeRequiredPluginLoad(registry, config, required.beginRequiredPluginLoad());
+  ready();
+  const log = logging.createSubsystemLogger("gateway/required-channel-test");
+  const manager = channels.createChannelManager({
+    getRuntimeConfig: () => config,
+    channelLogs: { discord: log } as Record<ChannelId, SubsystemLogger>,
+    channelRuntimeEnvs: { discord: logging.runtimeForLogger(log) } as Record<ChannelId, RuntimeEnv>,
+    ...(options.startupTrace ? { startupTrace: options.startupTrace } : {}),
+    ...(options.deferStartupAccountStartsUntil
+      ? { deferStartupAccountStartsUntil: options.deferStartupAccountStartsUntil }
+      : {}),
+  });
+  managers.push(manager);
+  return { manager, startAccount, ready };
+}
+
+describe("required plugins gate channel account admission", () => {
+  it("holds an early health restart despite a configured account snapshot, then repairs", async () => {
+    const { manager, startAccount, ready } = fixture();
+    required.beginRequiredPluginLoad();
+    expect(manager.getRuntimeSnapshot().channelAccounts.discord?.default).toMatchObject({
+      enabled: true,
+      configured: true,
+    });
+    expect(manager.getRuntimeSnapshot().channelAccounts.discord?.default.running).not.toBe(true);
+    monitors.push(
+      health.startChannelHealthMonitor({
+        channelManager: manager,
+        checkIntervalMs: 10,
+        startupGraceMs: 0,
+        cooldownCycles: 0,
+      }),
+    );
+    await vi.advanceTimersByTimeAsync(20);
+    expect(startAccount).not.toHaveBeenCalled();
+    ready();
+    await vi.advanceTimersByTimeAsync(20);
+    expect(startAccount).toHaveBeenCalledTimes(1);
+  });
+
+  it("rechecks after asynchronous account configuration before bootstrapping transport", async () => {
+    const configured = deferred<boolean>();
+    const reached = deferred<void>();
+    const { manager, startAccount } = fixture({
+      isConfigured: () => {
+        reached.resolve();
+        return configured.promise;
+      },
+    });
+    const starting = manager.startChannel("discord", "default");
+    await reached.promise;
+    required.beginRequiredPluginLoad();
+    configured.resolve(true);
+    await expect(starting).rejects.toThrow("Required plugin runtime is not ready");
+    expect(startAccount).not.toHaveBeenCalled();
+  });
+
+  it("rechecks account startup after the gateway handoff wait", async () => {
+    const handoff = deferred<void>();
+    const { manager, startAccount } = fixture({ deferStartupAccountStartsUntil: handoff.promise });
+    await manager.startChannels();
+    expect(startAccount).not.toHaveBeenCalled();
+    required.beginRequiredPluginLoad();
+    handoff.resolve();
+    await vi.advanceTimersByTimeAsync(1);
+    expect(startAccount).not.toHaveBeenCalled();
+    expect(manager.getRuntimeSnapshot().channelAccounts.discord?.default.lastError).toContain(
+      "Required plugin runtime is not ready",
+    );
+  });
+
+  it("reports a traced approval admission hold as failed startup before handoff", async () => {
+    const { manager, startAccount } = fixture({
+      startupTrace: {
+        measure: async (name, run) => {
+          if (name.endsWith(".approval-bootstrap")) {
+            required.beginRequiredPluginLoad();
+          }
+          return await run();
+        },
+      },
+    });
+    await expect(manager.startChannel("discord", "default")).rejects.toThrow(
+      "Required plugin runtime is not ready",
+    );
+    expect(startAccount).not.toHaveBeenCalled();
+    expect(manager.getRuntimeSnapshot().channelAccounts.discord?.default).toMatchObject({
+      running: false,
+      restartPending: false,
+    });
+  });
+
+  it("permits explicit recovery without a health monitor and keeps a manual stop stopped", async () => {
+    const handoff = deferred<void>();
+    const { manager, startAccount, ready } = fixture({
+      deferStartupAccountStartsUntil: handoff.promise,
+    });
+    await manager.startChannels();
+    required.beginRequiredPluginLoad();
+    handoff.resolve();
+    await vi.advanceTimersByTimeAsync(6000);
+    expect(startAccount).not.toHaveBeenCalled();
+    ready();
+    await manager.startChannel("discord", "default");
+    await vi.advanceTimersByTimeAsync(0);
+    expect(startAccount).toHaveBeenCalledTimes(1);
+    const stopping = manager.stopChannel("discord", "default");
+    await vi.advanceTimersByTimeAsync(6000);
+    await stopping;
+    expect(manager.isManuallyStopped("discord", "default")).toBe(true);
+    expect(startAccount).toHaveBeenCalledTimes(1);
+  });
+});
