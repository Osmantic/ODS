+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { GlobalHookRunnerRegistry } from "./hook-registry.types.js";
+
+const live = vi.hoisted(() => ({ registry: null as GlobalHookRunnerRegistry | null }));
+vi.mock("./hook-runner-global-state.js", () => ({
+  getGlobalHookRunnerRegistry: () => live.registry,
+}));
+
+const policy = { version: 1, plugins: [{ id: "guard", hooks: ["before_agent_run"] }] };
+const config: OpenClawConfig = {
+  plugins: {
+    entries: {
+      guard: { enabled: true, hooks: { allowConversationAccess: true } },
+    },
+  },
+};
+function registry(): GlobalHookRunnerRegistry {
+  return {
+    hooks: [],
+    plugins: [{ id: "guard", status: "loaded" }],
+    typedHooks: [
+      {
+        pluginId: "guard",
+        hookName: "before_agent_run",
+        handler: () => undefined,
+        source: "fixture",
+      },
+    ],
+  };
+}
+
+beforeEach(() => {
+  vi.resetModules();
+  vi.stubEnv("OPENCLAW_REQUIRED_PLUGINS", JSON.stringify(policy));
+  live.registry = registry();
+});
+afterEach(() => {
+  vi.unstubAllEnvs();
+  live.registry = null;
+  vi.resetModules();
+});
+
+describe("launcher-required plugins", () => {
+  it.each([false, true])(
+    "rejects stale completion after newer decision (newer completed=%s)",
+    async (completed) => {
+      const mod = await import("./required-plugins.js");
+      const older = mod.beginRequiredPluginLoad();
+      const newer = mod.beginRequiredPluginLoad();
+      if (completed) {
+        mod.completeRequiredPluginLoad(registry(), config, newer);
+      }
+      expect(() => mod.completeRequiredPluginLoad(registry(), config, older)).toThrow("Superseded");
+      expect(() => mod.assertRequiredPluginRuntime(config)).toThrow("runtime is not ready");
+      const repair = mod.beginRequiredPluginLoad();
+      mod.completeRequiredPluginLoad(registry(), config, repair);
+      expect(() => mod.assertRequiredPluginRuntime(config)).not.toThrow();
+    },
+  );
+
+  it("leaves legacy behavior unchanged without launcher policy", async () => {
+    vi.stubEnv("OPENCLAW_REQUIRED_PLUGINS", undefined);
+    const mod = await import("./required-plugins.js");
+    live.registry = null;
+    mod.beginRequiredPluginLoad();
+    mod.completeRequiredPluginLoad(
+      { hooks: [], typedHooks: [], plugins: [] },
+      {},
+      mod.beginRequiredPluginLoad(),
+    );
+    expect(() => mod.assertRequiredPluginRuntime(undefined)).not.toThrow();
+    expect(mod.getRequiredPluginRequirements()).toEqual([]);
+  });
+
+  it.each([
+    "",
+    "not-json",
+    "null",
+    "[]",
+    " ".repeat(16_385),
+    JSON.stringify({ version: 1, plugins: [] }),
+    JSON.stringify({ ...policy, extra: true }),
+    JSON.stringify({ ...policy, version: 2 }),
+    JSON.stringify({ ...policy, plugins: [...policy.plugins, ...policy.plugins] }),
+    JSON.stringify({ version: 1, plugins: [{ id: "guard", hooks: [] }] }),
+    JSON.stringify({ version: 1, plugins: [{ id: "guard", hooks: ["invented"] }] }),
+    JSON.stringify({ version: 1, plugins: [{ id: "guard", hooks: [null] }] }),
+    JSON.stringify({
+      version: 1,
+      plugins: [{ id: "guard", hooks: ["before_agent_run", "before_agent_run"] }],
+    }),
+    JSON.stringify({
+      version: 1,
+      plugins: [{ id: "guard\ninjected", hooks: ["before_agent_run"] }],
+    }),
+  ])("rejects malformed policy case %# without echoing input", async (raw) => {
+    vi.stubEnv("OPENCLAW_REQUIRED_PLUGINS", raw);
+    const mod = await import("./required-plugins.js");
+    expect(() => mod.getRequiredPluginRequirements()).toThrow(
+      "Invalid OPENCLAW_REQUIRED_PLUGINS launcher policy",
+    );
+  });
+
+  it("freezes the launcher contract before plugin code can change the environment", async () => {
+    const mod = await import("./required-plugins.js");
+    vi.stubEnv("OPENCLAW_REQUIRED_PLUGINS", undefined);
+    const required = mod.getRequiredPluginRequirements();
+    expect(required).toEqual(policy.plugins);
+    expect(Object.isFrozen(required)).toBe(true);
+    expect(Object.isFrozen(required[0].hooks)).toBe(true);
+    expect(() => mod.assertRequiredPluginConfiguration({})).toThrow();
+  });
+
+  it.each<OpenClawConfig | undefined>([
+    undefined,
+    {},
+    { plugins: { enabled: false } },
+    { plugins: { entries: { guard: { enabled: false } } } },
+    { plugins: { ...config.plugins, deny: ["guard"] } },
+    { plugins: { ...config.plugins, allow: ["another"] } },
+    { plugins: { entries: { guard: { enabled: true } } } },
+    {
+      plugins: { entries: { guard: { enabled: true, hooks: { allowConversationAccess: false } } } },
+    },
+  ])("refuses removed configuration or permissions %#", async (candidate) => {
+    const mod = await import("./required-plugins.js");
+    expect(() => mod.assertRequiredPluginRuntime(candidate)).toThrow(
+      "Required plugin configuration unavailable",
+    );
+  });
+
+  it.each(["error", "disabled"] as const)("refuses required plugin status %s", async (status) => {
+    const mod = await import("./required-plugins.js");
+    const candidate = registry();
+    candidate.plugins[0].status = status;
+    expect(() =>
+      mod.completeRequiredPluginLoad(candidate, config, mod.beginRequiredPluginLoad()),
+    ).toThrow("did not load");
+  });
+
+  it("requires a callable typed hook owned by the loaded plugin", async () => {
+    const mod = await import("./required-plugins.js");
+    const candidate = registry();
+    candidate.typedHooks[0].pluginId = "other";
+    expect(() =>
+      mod.completeRequiredPluginLoad(candidate, config, mod.beginRequiredPluginLoad()),
+    ).toThrow("hook unavailable");
+    candidate.typedHooks[0].pluginId = "guard";
+    Reflect.set(candidate.typedHooks[0], "handler", "not-callable");
+    expect(() =>
+      mod.completeRequiredPluginLoad(candidate, config, mod.beginRequiredPluginLoad()),
+    ).toThrow("hook unavailable");
+  });
+
+  it("ignores optional plugin failures", async () => {
+    const mod = await import("./required-plugins.js");
+    const candidate = registry();
+    candidate.plugins.push({ id: "optional", status: "error" });
+    mod.beginRequiredPluginLoad();
+    mod.completeRequiredPluginLoad(candidate, config, mod.beginRequiredPluginLoad());
+    expect(() => mod.assertRequiredPluginRuntime(config)).not.toThrow();
+  });
+
+  it("keeps failed reload closed despite retained good hooks, then permits repair", async () => {
+    const mod = await import("./required-plugins.js");
+    mod.completeRequiredPluginLoad(registry(), config, mod.beginRequiredPluginLoad());
+    mod.beginRequiredPluginLoad();
+    const broken = registry();
+    broken.typedHooks = [];
+    expect(() =>
+      mod.completeRequiredPluginLoad(broken, config, mod.beginRequiredPluginLoad()),
+    ).toThrow("hook unavailable");
+    expect(() => mod.assertRequiredPluginRuntime(config)).toThrow("runtime is not ready");
+    mod.completeRequiredPluginLoad(registry(), config, mod.beginRequiredPluginLoad());
+    expect(() => mod.assertRequiredPluginRuntime(config)).not.toThrow();
+  });
+
+  it("detects disappearing composed hooks on each run", async () => {
+    const mod = await import("./required-plugins.js");
+    mod.completeRequiredPluginLoad(registry(), config, mod.beginRequiredPluginLoad());
+    expect(() => mod.assertRequiredPluginRuntime(config)).not.toThrow();
+    live.registry = { ...registry(), typedHooks: [] };
+    expect(() => mod.assertRequiredPluginRuntime(config)).toThrow("hook unavailable");
+    live.registry = null;
+    expect(() => mod.assertRequiredPluginRuntime(config)).toThrow("did not load");
+  });
+});
