+      const parent = `const c = require('node:child_process').spawn(process.execPath, ['-e', ${JSON.stringify(descendant)}], {stdio:'ignore'}); require('node:fs').writeFileSync(${JSON.stringify(childPidFile)}, String(c.pid)); c.unref();`;
+      let inspect: CommandProcessInspection | undefined;
+      let active = 0;
+      register(() => {
+        active += 1;
+        return allow(({ inspectProcess }) => {
