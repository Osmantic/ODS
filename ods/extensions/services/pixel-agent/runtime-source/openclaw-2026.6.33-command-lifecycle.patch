+  it.skipIf(process.platform === "win32").each(["deadline", "owner", "abort", "observer-error"])(
+    "reaps a TERM-ignoring descendant after root exit via %s",
+    async (mode) => {
+      const ready = path.join(temp, "stubborn-ready");
+      const term = path.join(temp, "stubborn-term");
+      const naturalExit = path.join(temp, "stubborn-natural-exit");
+      const descendant = `const fs=require('node:fs'); process.on('SIGTERM',()=>fs.writeFileSync(${JSON.stringify(term)},'seen')); fs.writeFileSync(${JSON.stringify(ready)},'ready'); setTimeout(()=>{fs.writeFileSync(${JSON.stringify(naturalExit)},'expired');process.exit(0)},4000);`;
+      // The root cannot finish before the child has installed its TERM handler.
