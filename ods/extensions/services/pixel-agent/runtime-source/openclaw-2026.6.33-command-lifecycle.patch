+++ b/src/process/command-process-state.ts
@@ -0,0 +1,86 @@
+import type { ChildProcess } from "node:child_process";
+import { setTimeout as delay } from "node:timers/promises";
+
+/** Evidence about our execution domain, not containment of escaped OS processes. */
+export type CommandProcessState =
+  | { state: "not-started" }
+  | { state: "running" | "exited"; scope: "process-group"; pid: number }
+  | { state: "unknown"; scope: "process-group" | "untracked"; pid?: number };
+
+export type CommandProcessInspection = () => Readonly<CommandProcessState>;
+/** Requests termination of this domain. Resolution is not proof of exit. */
+export type CommandProcessCancel = () => Promise<void>;
+
+/** The runner exposes inspect only once its own promise has settled. */
+export function createCommandProcessTracker() {
+  let child: ChildProcess | undefined;
+  let ownsGroup = false;
+  let terminal: Readonly<CommandProcessState> | undefined;
+  let cancellation: Promise<void> | undefined;
+  const inspect: CommandProcessInspection = () => {
+    if (terminal) {
+      return terminal;
+    }
+    // Node supplies no pid when spawn failed. No caller gets this observation
+    // while a later spawn is still possible.
+    if (!child || child.pid === undefined) {
+      terminal = Object.freeze({ state: "not-started" });
+      return terminal;
+    }
+    const pid = child.pid;
