+    }
+  });
+
+  it("retains unknown producer cleanup and surfaces finish rejection", async () => {
+    const finish = vi.fn(({ inspectProcess }: Parameters<PluginHookCommandFinish>[0]) => {
+      expect(inspectProcess()).toEqual({ state: "unknown", scope: "untracked" });
+      throw new Error("retain hold");
