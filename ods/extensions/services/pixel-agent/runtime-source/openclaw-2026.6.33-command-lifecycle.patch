@@ -0,0 +1,544 @@
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { GlobalHookRunnerRegistry } from "../plugins/hook-registry.types.js";
+import type {
+  PluginHookCommandFinish,
+  PluginHookHandlerMap,
+  PluginHookBeforeCommandRunResult,
+} from "../plugins/hook-types.js";
+import type {
+  CommandProcessCancel,
+  CommandProcessInspection,
+} from "../process/command-process-state.js";
+import type { CronJob } from "./types.js";
+
+const live = vi.hoisted(() => ({ registry: null as GlobalHookRunnerRegistry | null }));
+vi.mock("../plugins/hook-runner-global-state.js", () => ({
+  getGlobalHookRunnerRegistry: () => live.registry,
+}));
+vi.mock("../logger.js", () => ({ logError: vi.fn(), logDebug: vi.fn() }));
+
+const policy = { version: 1, plugins: [{ id: "guard", hooks: ["before_command_run"] }] };
+const config = {
+  plugins: { entries: { guard: { enabled: true, hooks: { allowConversationAccess: true } } } },
+};
+let run: typeof import("./command-runner.js").runCronCommandJob;
+let required: typeof import("../plugins/required-plugins.js");
+let admission: typeof import("../plugins/command-lifecycle.js").runWithCommandAdmission;
+let temp: string;
+
+function job(code = "process.stdout.write('hello')"): CronJob {
+  return {
+    id: "command-job",
+    name: "Command job",
+    enabled: true,
+    createdAtMs: 1,
+    updatedAtMs: 1,
+    schedule: { kind: "every", everyMs: 60_000 },
+    sessionTarget: "isolated",
+    wakeMode: "now",
+    state: {},
+    payload: { kind: "command", argv: [process.execPath, "-e", code], timeoutSeconds: 5 },
+  };
+}
+
+function allow(finish: PluginHookCommandFinish) {
+  return { action: "allow" as const, finish };
+}
+
+function register(handler: PluginHookHandlerMap["before_command_run"]) {
+  live.registry = {
+    hooks: [],
+    plugins: [{ id: "guard", status: "loaded" }],
+    typedHooks: [{ pluginId: "guard", hookName: "before_command_run", source: "fixture", handler }],
+  };
+}
+
+beforeEach(async () => {
+  temp = await fs.mkdtemp(path.join(os.tmpdir(), "command-lifecycle-"));
+  vi.resetModules();
+  vi.stubEnv("OPENCLAW_REQUIRED_PLUGINS", JSON.stringify(policy));
+  register(() => allow(() => {}));
+  ({ runCronCommandJob: run } = await import("./command-runner.js"));
+  required = await import("../plugins/required-plugins.js");
+  ({ runWithCommandAdmission: admission } = await import("../plugins/command-lifecycle.js"));
+});
+
+afterEach(async () => {
+  live.registry = null;
+  vi.unstubAllEnvs();
+  vi.restoreAllMocks();
+  vi.resetModules();
+  await fs.rm(temp, { recursive: true, force: true });
+});
+
+describe("direct cron command lifecycle", () => {
+  it.each(["loading", "disabled", "missing-hook", "missing-config"])(
+    "refuses %s before any process effect",
+    async (variant) => {
+      const marker = path.join(temp, "must-not-exist");
+      const finish = vi.fn();
+      const handler = vi.fn(() => allow(finish));
+      register(handler);
+      if (variant === "loading") {
+        required.beginRequiredPluginLoad();
+      }
+      if (variant === "missing-hook") {
+        live.registry!.typedHooks = [];
+      }
+      const getConfig =
+        variant === "disabled" ? () => ({ plugins: { enabled: false } }) : () => config;
+      const result = await run({
+        job: job(`require('node:fs').writeFileSync(${JSON.stringify(marker)}, 'bad')`),
+        ...(variant === "missing-config" ? {} : { getConfig }),
+      });
+      expect(result.status).toBe("error");
+      expect(handler).not.toHaveBeenCalled();
+      expect(finish).not.toHaveBeenCalled();
+      await expect(fs.stat(marker)).rejects.toMatchObject({ code: "ENOENT" });
+    },
+  );
+
+  it.each(["block", "undefined", "throw"])("refuses a %s decision", async (kind) => {
+    register(() => {
+      if (kind === "throw") {
+        throw new Error("owner gate failed");
+      }
+      if (kind === "undefined") {
+        return undefined as unknown as PluginHookBeforeCommandRunResult;
+      }
+      return { action: "block" };
+    });
+    const result = await run({ job: job(), getConfig: () => config });
+    expect(result.status).toBe("error");
+    expect(result.summary).toBeUndefined();
+  });
+
+  it("keeps a reservation while real command work is pending, then proves group exit", async () => {
+    const started = path.join(temp, "started");
+    let active = 0;
+    const finish = vi.fn(({ inspectProcess }: Parameters<PluginHookCommandFinish>[0]) => {
+      const state = inspectProcess();
+      if (process.platform === "win32") {
+        // Native Windows has no group observation adapter yet. A successful
+        // command result must not turn this unknown lease into an idle claim.
+        expect(state).toMatchObject({ state: "unknown", scope: "untracked" });
+      } else {
+        expect(state).toMatchObject({ state: "exited", scope: "process-group" });
+        active -= 1;
+      }
+    });
+    register(() => {
+      active += 1;
+      return allow(finish);
+    });
+    const pending = run({
+      job: job(
+        `require('node:fs').writeFileSync(${JSON.stringify(started)}, 'ready'); setTimeout(() => process.stdout.write('done'), 250)`,
+      ),
+      getConfig: () => config,
+    });
+    await vi.waitFor(async () => expect(await fs.readFile(started, "utf8")).toBe("ready"));
+    expect(active).toBe(1);
+    expect(finish).not.toHaveBeenCalled();
+    expect((await pending).status).toBe("ok");
+    expect(active).toBe(process.platform === "win32" ? 1 : 0);
+    expect(finish).toHaveBeenCalledTimes(1);
+  });
+
+  it("unwinds the original generation and never spawns after a reload during admission", async () => {
+    const oldFinish = vi.fn();
+    const newFinish = vi.fn();
+    register(async () => {
+      const generation = required.beginRequiredPluginLoad();
+      register(() => allow(newFinish));
+      required.completeRequiredPluginLoad(live.registry!, config, generation);
+      return allow(oldFinish);
+    });
+    const result = await run({ job: job(), getConfig: () => config });
+    expect(result.status).toBe("error");
+    expect(result.error).toContain("changed during admission");
+    expect(oldFinish).toHaveBeenCalledTimes(1);
+    expect(oldFinish.mock.calls[0][0].inspectProcess()).toEqual({ state: "not-started" });
+    expect(newFinish).not.toHaveBeenCalled();
+  });
+
+  it("uses the original finish after a registry replacement during execution", async () => {
+    let unblock!: () => void;
+    const entered = new Promise<void>((resolve) => {
+      unblock = resolve;
+    });
+    let complete!: () => void;
+    const pending = new Promise<void>((resolve) => {
+      complete = resolve;
+    });
+    const oldFinish = vi.fn();
+    const newFinish = vi.fn();
+    register(() => allow(oldFinish));
+    const work = admission({
+      event: { commandId: "old-command", jobId: "job", argv: [], cwd: temp, env: {} },
+      getConfig: () => config,
+      execute: async (settled) => {
+        unblock();
+        await pending;
+        settled!(
+          () => ({ state: "not-started" }),
+          async () => {},
+        );
+      },
+    });
+    await entered;
+    register(() => allow(newFinish));
+    complete();
+    await work;
+    expect(oldFinish).toHaveBeenCalledTimes(1);
+    expect(newFinish).not.toHaveBeenCalled();
+  });
+
+  it("unwinds an earlier allowed lease when a later plugin refuses", async () => {
+    const finish = vi.fn();
+    register(() => allow(finish));
+    live.registry!.plugins.push({ id: "second", status: "loaded" });
+    live.registry!.typedHooks.push({
+      pluginId: "second",
+      source: "fixture",
+      hookName: "before_command_run",
+      handler: () => ({ action: "block" }),
+    });
+    expect((await run({ job: job(), getConfig: () => config })).status).toBe("error");
+    expect(finish).toHaveBeenCalledTimes(1);
+    expect(finish.mock.calls[0][0].inspectProcess()).toEqual({ state: "not-started" });
+  });
+
+  it("does not use mutable job argv/env after admission begins", async () => {
+    vi.stubEnv("COMMAND_PRIVATE_GATEWAY_VALUE", "private-fixture");
+    const source = job("process.stdout.write(process.env.COMMAND_FIXTURE_VALUE)");
+    if (source.payload.kind !== "command") {
+      throw new Error("bad fixture");
+    }
+    source.payload.env = { COMMAND_FIXTURE_VALUE: "original" };
+    register((event) => {
+      expect(Object.isFrozen(event)).toBe(true);
+      expect(event.env).not.toHaveProperty("COMMAND_PRIVATE_GATEWAY_VALUE");
+      if (source.payload.kind === "command") {
+        source.payload.argv[2] = "process.stdout.write('changed')";
+        source.payload.env!.COMMAND_FIXTURE_VALUE = "changed";
+      }
+      return allow(() => {});
+    });
+    expect((await run({ job: source, getConfig: () => config })).summary).toBe("original");
+  });
+
+  it("cleans a late allow after abort without starting the command", async () => {
+    const controller = new AbortController();
+    let release!: () => void;
+    const wait = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    let entered!: () => void;
+    const begun = new Promise<void>((resolve) => {
+      entered = resolve;
+    });
+    const finish = vi.fn();
+    register(async () => {
+      entered();
+      await wait;
+      return allow(finish);
+    });
+    const work = run({ job: job(), getConfig: () => config, abortSignal: controller.signal });
+    await begun;
+    controller.abort();
+    expect((await work).status).toBe("error");
+    expect(finish).not.toHaveBeenCalled();
+    release();
+    await vi.waitFor(() => expect(finish).toHaveBeenCalledTimes(1));
+    expect(finish.mock.calls[0][0].inspectProcess()).toEqual({ state: "not-started" });
+  });
+
+  it("reports failed spawn as not started", async () => {
+    const finish = vi.fn();
+    register(() => allow(finish));
+    const source = job();
+    if (source.payload.kind === "command") {
+      source.payload.argv = [path.join(temp, "missing-executable")];
+    }
+    expect((await run({ job: source, getConfig: () => config })).status).toBe("error");
+    expect(finish.mock.calls[0][0].inspectProcess()).toEqual({ state: "not-started" });
+  });
+
+  it("unwinds a timed-out admission's late allow exactly once", async () => {
+    const finish = vi.fn();
+    let release!: () => void;
+    const pending = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    register(async () => {
+      await pending;
+      return allow(finish);
+    });
+    live.registry!.typedHooks[0].timeoutMs = 20;
+    expect((await run({ job: job(), getConfig: () => config })).status).toBe("error");
+    expect(finish).not.toHaveBeenCalled();
+    release();
+    await vi.waitFor(() => expect(finish).toHaveBeenCalledTimes(1));
+    expect(finish.mock.calls[0][0].inspectProcess()).toEqual({ state: "not-started" });
+  });
+
+  it("bounds unknown cleanup without calling the owner's finish twice", async () => {
+    let release!: () => void;
+    const pending = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const finish = vi.fn(async () => {
+      await pending;
+    });
+    register(() => allow(finish));
+    live.registry!.typedHooks[0].timeoutMs = 20;
+    const result = await run({ job: job(), getConfig: () => config });
+    expect(result.status).toBe("error");
+    expect(result.error).toContain("cleanup failed");
+    expect(finish).toHaveBeenCalledTimes(1);
+    release();
+    await delay(10);
+    expect(finish).toHaveBeenCalledTimes(1);
+  });
+
+  it("observes real aborted-process cleanup independently of the cancellation request", async () => {
+    const started = path.join(temp, "abort-started");
+    const controller = new AbortController();
+    let inspect: CommandProcessInspection | undefined;
+    register(() =>
+      allow(({ inspectProcess }) => {
+        inspect = inspectProcess;
+      }),
+    );
+    const pending = run({
+      job: job(
+        `require('node:fs').writeFileSync(${JSON.stringify(started)}, 'ready'); setTimeout(() => {}, 2000)`,
+      ),
+      getConfig: () => config,
+      abortSignal: controller.signal,
+    });
+    await vi.waitFor(async () => expect(await fs.readFile(started, "utf8")).toBe("ready"));
+    controller.abort();
+    expect((await pending).status).toBe("error");
+    if (process.platform === "win32") {
+      expect(inspect!()).toMatchObject({ state: "unknown", scope: "untracked" });
+    } else {
+      await vi.waitFor(() =>
+        expect(inspect!()).toMatchObject({ state: "exited", scope: "process-group" }),
