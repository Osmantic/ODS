+import type { ChildProcess } from "node:child_process";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createCommandProcessTracker } from "./command-process-state.js";
+
+afterEach(() => vi.restoreAllMocks());
+
+function child(values: Partial<ChildProcess> = {}): ChildProcess {
+  return { pid: 12345, exitCode: 0, signalCode: null, ...values } as ChildProcess;
+}
+
+describe("owned command process evidence", () => {
+  it("distinguishes no spawn from unsupported ownership", () => {
+    const tracker = createCommandProcessTracker();
+    expect(tracker.inspect()).toEqual({ state: "not-started" });
+    const untracked = createCommandProcessTracker();
+    untracked.spawned(child(), false);
+    expect(untracked.inspect()).toEqual({ state: "unknown", scope: "untracked", pid: 12345 });
+  });
+
+  it("does not infer group exit while root termination remains unobserved", () => {
+    const kill = vi.spyOn(process, "kill").mockImplementation(() => {
+      throw Object.assign(new Error(), { code: "ESRCH" });
+    });
+    const tracker = createCommandProcessTracker();
+    tracker.spawned(child({ exitCode: null }), true);
+    expect(tracker.inspect()).toMatchObject({ state: "running", scope: "process-group" });
+    expect(kill).not.toHaveBeenCalled();
+  });
+
+  it.each(["EPERM", "EACCES", "EIO"])("retains unknown on %s", (code) => {
+    vi.spyOn(process, "kill").mockImplementation(() => {
+      throw Object.assign(new Error(), { code });
+    });
+    const tracker = createCommandProcessTracker();
+    tracker.spawned(child(), true);
+    expect(tracker.inspect()).toMatchObject({ state: "unknown", scope: "process-group" });
+  });
+
+  it("pins kernel-proven absence, not root success or a successful signal probe", () => {
+    const kill = vi.spyOn(process, "kill").mockReturnValue(true);
+    const tracker = createCommandProcessTracker();
+    tracker.spawned(child(), true);
+    expect(tracker.inspect()).toMatchObject({ state: "running" });
+    kill.mockImplementationOnce(() => {
+      throw Object.assign(new Error(), { code: "ESRCH" });
+    });
+    expect(tracker.inspect()).toMatchObject({ state: "exited", scope: "process-group" });
+    const calls = kill.mock.calls.length;
+    expect(tracker.inspect()).toMatchObject({ state: "exited" });
+    expect(kill).toHaveBeenCalledTimes(calls);
+    expect(kill.mock.calls.every(([pid, signal]) => pid === -12345 && signal === 0)).toBe(true);
+  });
+});
