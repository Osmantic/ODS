+        event: { commandId: "unknown-command", jobId: "job", argv: [], cwd: temp, env: {} },
+        getConfig: () => config,
+        execute: async () => {
+          throw new Error("lost transport");
+        },
+      }),
+    ).rejects.toThrow("Command cleanup failed");
+    expect(finish).toHaveBeenCalledTimes(1);
+  });
+
+  it("leaves non-command agent payloads on the original separate path", async () => {
+    const handler = vi.fn(() => allow(() => {}));
+    register(handler);
+    const source = job();
+    source.payload = { kind: "agentTurn", message: "do not invoke a model" };
+    expect((await run({ job: source, getConfig: () => config })).status).toBe("skipped");
+    expect(handler).not.toHaveBeenCalled();
+  });
+
+  it.skipIf(process.platform === "win32")(
+    "retains a real surviving descendant until its owned group is absent",
+    async () => {
+      const childPidFile = path.join(temp, "descendant-pid");
