new file mode 100644
index 0000000000000000000000000000000000000000..5868d9420db8e2835d36e61098f695891f60de9b
--- /dev/null
+++ b/src/plugins/command-lifecycle.ts
@@ -0,0 +1,212 @@
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { logError } from "../logger.js";
+import type {
+  CommandProcessInspection,
+  CommandProcessCancel,
+} from "../process/command-process-state.js";
+import { clampPositiveTimerTimeoutMs } from "../shared/number-coercion.js";
+import { getGlobalHookRunnerRegistry } from "./hook-runner-global-state.js";
+import type {
+  PluginHookBeforeCommandRunEvent,
+  PluginHookBeforeCommandRunResult,
+  PluginHookCommandFinish,
+  PluginHookRegistration,
+} from "./hook-types.js";
+import { captureRequiredPluginRuntime } from "./required-plugins.js";
+
+const notStarted: CommandProcessInspection = () => Object.freeze({ state: "not-started" });
+const unknownProcess: CommandProcessInspection = () =>
+  Object.freeze({ state: "unknown", scope: "untracked" });
+const noProcessToCancel: CommandProcessCancel = async () => {};
+const unknownCancellation: CommandProcessCancel = async () => {
+  throw new Error("Command process ownership is unknown");
+};
+
+function commandHooks() {
+  const registry = getGlobalHookRunnerRegistry();
+  const loaded = new Set(registry?.plugins.filter((p) => p.status === "loaded").map((p) => p.id));
+  return (
+    (registry?.typedHooks ?? [])
+      .filter(
+        (hook): hook is PluginHookRegistration<"before_command_run"> =>
+          hook.hookName === "before_command_run" && loaded.has(hook.pluginId),
+      )
+      // Snapshot registrations so in-place registry edits cannot rewrite the
+      // admitted generation's handles or defeat the final identity check.
+      // oxlint-disable-next-line oxc/no-map-spread
+      .map((hook) => ({ ...hook }))
+      .toSorted((a, b) => (b.priority ?? 0) - (a.priority ?? 0))
+  );
+}
+
+function isAllow(value: PluginHookBeforeCommandRunResult | undefined): value is {
+  action: "allow";
+  finish: PluginHookCommandFinish;
+} {
+  return value?.action === "allow" && typeof value.finish === "function";
+}
+
+function pinFinish(finish: PluginHookCommandFinish, timeoutMs: number): PluginHookCommandFinish {
+  let completion: Promise<void> | undefined;
+  return (event) => {
+    if (!completion) {
+      completion = (async () => {
+        let timer: ReturnType<typeof setTimeout> | undefined;
+        try {
+          await Promise.race([
+            Promise.resolve().then(() => finish(event)),
+            new Promise<never>((_, reject) => {
+              timer = setTimeout(() => reject(new Error("Command cleanup timed out")), timeoutMs);
+            }),
+          ]);
+        } finally {
+          clearTimeout(timer);
+        }
+      })();
+    }
+    // Preserve the same success or rejection on repeat, never repeat effects or
+    // turn an earlier failed cleanup into a later apparent success.
+    return completion;
+  };
+}
+
+async function admit(
+  hook: PluginHookRegistration<"before_command_run">,
+  event: PluginHookBeforeCommandRunEvent,
+  signal?: AbortSignal,
+): Promise<PluginHookBeforeCommandRunResult> {
+  const controller = new AbortController();
+  let abandoned = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let onAbort: (() => void) | undefined;
+  const timeoutMs = clampPositiveTimerTimeoutMs(hook.timeoutMs) ?? 15_000;
+  const stop = new Promise<never>((_, reject) => {
+    onAbort = () => {
+      abandoned = true;
+      controller.abort();
+      reject(new Error("Command admission interrupted"));
+    };
+    signal?.addEventListener("abort", onAbort, { once: true });
+    timer = setTimeout(onAbort, timeoutMs);
+  });
+  // A late allow still owns a lease. Unwind its original closure rather than
+  // redispatching through a possibly replaced global registry.
+  const decision = Promise.resolve()
+    .then(() => {
+      if (signal?.aborted || abandoned) {
+        throw new Error("command stopped");
+      }
+      return hook.handler(event, { signal: controller.signal });
+    })
+    .then((value) =>
+      isAllow(value)
+        ? { action: "allow" as const, finish: pinFinish(value.finish, timeoutMs) }
+        : value,
+    );
+  void decision
+    .then(
+      async (value) => {
+        if (abandoned && isAllow(value)) {
+          await value.finish({
+            commandId: event.commandId,
+            inspectProcess: notStarted,
+            cancelProcess: noProcessToCancel,
+          });
+        }
+      },
+      () => {},
+    )
+    .catch(() => logError("Command admission late cleanup failed; activity remains uncertain"));
+  try {
+    return await Promise.race([decision, stop]);
+  } finally {
+    clearTimeout(timer);
+    if (onAbort) {
+      signal?.removeEventListener("abort", onAbort);
+    }
+  }
+}
+
+/** Admission and cleanup share one immutable event and one set of owner closures. */
+export async function runWithCommandAdmission<T>(params: {
+  event: PluginHookBeforeCommandRunEvent;
+  getConfig: () => OpenClawConfig | undefined;
+  signal?: AbortSignal;
+  execute: (
+    settled?: (inspect: CommandProcessInspection, cancel: CommandProcessCancel) => void,
+  ) => Promise<T>;
+}): Promise<T> {
+  const assertRuntime = captureRequiredPluginRuntime(params.getConfig());
+  const hooks = commandHooks();
+  const finishes: PluginHookCommandFinish[] = [];
+  let inspectProcess = notStarted;
+  let cancelProcess = noProcessToCancel;
+  const assertCurrent = () => {
+    if (params.signal?.aborted) {
+      throw new Error("command stopped");
+    }
+    assertRuntime(params.getConfig());
+    const current = commandHooks();
+    if (
+      current.length !== hooks.length ||
+      current.some(
+        (hook, index) =>
+          hook.pluginId !== hooks[index].pluginId ||
+          hook.handler !== hooks[index].handler ||
+          hook.priority !== hooks[index].priority ||
+          hook.timeoutMs !== hooks[index].timeoutMs,
+      )
+    ) {
+      throw new Error("Command hooks changed during admission");
+    }
+  };
+  let failure: unknown;
+  let failed = false;
+  let result: T | undefined;
+  try {
+    for (const hook of hooks) {
+      assertCurrent();
+      const decision = await admit(hook, params.event, params.signal);
+      if (!isAllow(decision)) {
+        throw new Error("Command admission refused");
+      }
+      finishes.push(decision.finish);
+    }
+    assertCurrent();
+    // No await between the final guard and execute's synchronous spawn prefix.
+    // Missing/erroring producer evidence remains unknown, never inferred idle.
+    inspectProcess = unknownProcess;
+    cancelProcess = unknownCancellation;
+    result = await params.execute(
+      hooks.length === 0
+        ? undefined
+        : (inspect, cancel) => {
+            inspectProcess = inspect;
+            cancelProcess = cancel;
+          },
+    );
+  } catch (error) {
+    failure = error;
+    failed = true;
+  }
+  const cleanup = await Promise.allSettled(
+    finishes.map((finish) =>
+      Promise.resolve().then(() =>
+        finish({ commandId: params.event.commandId, inspectProcess, cancelProcess }),
+      ),
+    ),
+  );
+  const cleanupErrors = cleanup.flatMap((entry) =>
+    entry.status === "rejected" ? [entry.reason] : [],
+  );
+  if (cleanupErrors.length > 0) {
+    throw new AggregateError(
+      failed ? [failure, ...cleanupErrors] : cleanupErrors,
+      "Command cleanup failed; activity remains uncertain",
+    );
+  }
+  if (failed) {
+    throw failure;
+  }
+  return result as T;
+}
