      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Night Garden FLEET-c8c40c5702</title>\n  <style>\n    *, *::before, *::after {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    :root {\n      --primary-purple: #6c5ce7;\n      --secondary-purple: #a29bfe;\n      --dark-bg: #0a0a0f;\n      --card-bg: #1a1a2e;\n      --text-primary: #ffffff;\n      --text-secondary: #b8b8d0;\n      --accent-gold: #fdcb6e;\n      --sold-out-bg: #2d2d44;\n      --sold-out-overlay: rgba(0, 0, 0, 0.95);\n    }\n\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      background: var(--dark-bg);\n      background: linear-gradient(135deg, var(--dark-bg) 0%, #16213e 100%);\n      min-height: 100vh;\n      color: var(--text-primary);\n      line-height: 1.6;\n    }\n\n    .container {\n      max-width: 1200px;\n      margin: 0 auto;\n      padding: 2rem 1rem;\n    }\n\n    header {\n      text-align: center;\n      padding: 3rem 0 2rem;\n    }\n\n    h1 {\n      font-size: clamp(2rem, 5vw, 3.5rem);\n      font-weight: 800;\n      background: linear-gradient(135deg, var(--secondary-purple) 0%, var(--accent-gold) 100%);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      background-clip: text;\n      text-transform: uppercase;\n      letter-spacing: 3px;\n      margin-bottom: 1rem;\n    }\n\n    .subtitle {\n      font-size: 1.1rem;\n      color: var(--text-secondary);\n      font-weight: 300;\n    }\n\n    .events-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n      gap: 2rem;\n      margin-top: 2rem;\n    }\n\n    .event-card {\n      background: var(--card-bg);\n      border-radius: 16px;\n      overflow: hidden;\n      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);\n      transition: transform 0.3s ease, box-shadow 0.3s ease;\n      opacity: 1;\n      transform: none;\n    }\n\n    .event-card.hidden {\n      opacity: 0;\n      transform: translateY(20px);\n      pointer-events: none;\n    }\n\n    .event-card:hover {\n      transform: translateY(-8px);\n      box-shadow: 0 16px 48px rgba(108, 92, 231, 0.3);\n    }\n\n    .card-image {\n      height: 200px;\n      background: linear-gradient(135deg, var(--primary-purple) 0%, #8854d0 100%);\n      position: relative;\n      overflow: hidden;\n    }\n\n    .card-image::before {\n      content: '';\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      background: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zm0-30V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n    }\n\n    .card-content {\n      padding: 1.5rem;\n    }\n\n    .event-title {\n      font-size: 1.4rem;\n      font-weight: 700;\n      margin-bottom: 0.5rem;\n      color: var(--text-primary);\n    }\n\n    .event-time {\n      font-size: 0.95rem;\n      color: var(--accent-gold);\n      margin-bottom: 1rem;\n      font-weight: 500;\n    }\n\n    .event-description {\n      font-size: 0.95rem;\n      color: var(--text-secondary);\n      margin-bottom: 1rem;\n    }\n\n    .event-details {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 1rem;\n      font-size: 0.85rem;\n      color: var(--text-secondary);\n    }\n\n    .detail-item {\n      display: flex;\n      align-items: center;\n      gap: 0.3rem;\n    }\n\n    .sold-out-badge {\n      position: absolute;\n      top: 1rem;\n      right: 1rem;\n      background: var(--accent-gold);\n      color: var(--dark-bg);\n      padding: 0.5rem 1rem;\n      border-radius: 20px;\n      font-weight: 700;\n      font-size: 0.8rem;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n\n    .sold-out-overlay {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      background: var(--sold-out-overlay);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      opacity: 0;\n      transition: opacity 0.3s ease;\n    }\n\n    .event-card.sold-out .sold-out-overlay {\n      opacity: 1;\n    }\n\n    .sold-out-message {\n      color: var(--accent-gold);\n      font-weight: 700;\n      font-size: 1.2rem;\n      text-align: center;\n      padding: 1rem;\n    }\n\n    .cta-button {\n      display: inline-block;\n      background: linear-gradient(135deg, var(--primary-purple) 0%, var(--secondary-purple) 100%);\n      color: white;\n      padding: 0.75rem 1.5rem;\n      border: none;\n      border-radius: 8px;\n      font-size: 0.9rem;\n      font-weight: 600;\n      cursor: pointer;\n      transition: transform 0.2s ease, box-shadow 0.2s ease;\n      margin-top: 1rem;\n    }\n\n    .cta-button:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 8px 20px rgba(108, 92, 231, 0.4);\n    }\n\n    .cta-button:active {\n      transform: translateY(0);\n    }\n\n    .toggle-section {\n      text-align: center;\n      margin: 3rem 0 2rem;\n      padding: 1rem;\n    }\n\n    .show-sold-out-btn {\n      background: transparent;\n      border: 2px solid var(--primary-purple);\n      color: var(--text-primary);\n      padding: 0.75rem 2rem;\n      font-size: 1rem;\n      font-weight: 600;\n      border-radius: 50px;\n      cursor: pointer;\n      transition: all 0.3s ease;\n      letter-spacing: 1px;\n      text-transform: uppercase;\n    }\n\n    .show-sold-out-btn:hover {\n      background: var(--primary-purple);\n      box-shadow: 0 8px 24px rgba(108, 92, 231, 0.4);\n    }\n\n    .show-sold-out-btn:active {\n      transform: scale(0.98);\n    }\n\n    footer {\n      text-align: center;\n      padding: 2rem;\n      color: var(--text-secondary);\n      font-size: 0.9rem;\n      border-top: 1px solid rgba(255, 255, 255, 0.1);\n      margin-top: 2rem;\n    }\n\n    @media (max-width: 375px) {\n      .container {\n        padding: 1rem 0.75rem;\n      }\n\n      header {\n        padding: 2rem 0 1.5rem;\n      }\n\n      .events-grid {\n        grid-template-columns: 1fr;\n        gap: 1.5rem;\n      }\n\n      .event-card {\n        border-radius: 12px;\n      }\n\n      .card-image {\n        height: 160px;\n      }\n\n      .card-content {\n        padding: 1.25rem;\n      }\n\n      .event-title {\n        font-size: 1.2rem;\n      }\n\n      .event-details {\n        flex-direction: column;\n        gap: 0.5rem;\n      }\n\n      .show-sold-out-btn {\n        padding: 0.6rem 1.5rem;\n        font-size: 0.9rem;\n      }\n    }\n\n    @media (max-width: 768px) {\n      .events-grid {\n        grid-template-columns: 1fr;\n        gap: 1.5rem;\n      }\n\n      h1 {\n        font-size: 2rem;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .event-card {\n        transition: none;\n      }\n\n      .event-card.hidden {\n        transform: none;\n      }\n\n      .sold-out-overlay {\n        transition: none;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <header>\n      <h1>Night Garden FLEET-c8c40c5702</h1>\n      <p class=\"subtitle\">An unforgettable night of music, culture, and magic</p>\n    </header>\n\n    <main>\n      <div class=\"events-grid\">\n        <article class=\"event-card\">\n          <div class=\"card-image\">\n            <div class=\"card-content\">\n              <h2 class=\"event-title\">Dawn Jazz</h2>\n              <p class=\"event-time\">🎵 8:00 PM - 10:00 PM</p>\n              <p class=\"event-description\">\n                Experience smooth jazz melodies as the night transitions into dawn.\n                Featuring renowned artists from around the globe, bringing together\n                the best of contemporary and classic jazz in an intimate setting.\n              </p>\n              <div class=\"event-details\">\n                <span class=\"detail-item\">🎷 Live Performance</span>\n                <span class=\"detail-item\">🎺 20+ Musicians</span>\n                <span class=\"detail-item\">🎟️ All Ages</span>\n              </div>\n              <button class=\"cta-button\">Get Tickets</button>\n            </div>\n          </div>\n        </article>\n\n        <article class=\"event-card\">\n          <div class=\"card-image\" style=\"background: linear-gradient(135deg, #6c5ce7 0%, #00b894 100%);\">\n            <div class=\"card-content\">\n              <h2 class=\"event-title\">River Lantern Walk</h2>\n              <p class=\"event-time\">🏮 9:00 PM - 11:00 PM</p>\n              <p class=\"event-description\">\n                Join us for a serene walk along the riverbank adorned with thousands\n                of glowing lanterns. A peaceful journey through light and reflection,\n                celebrating the beauty of our natural surroundings.\n              </p>\n              <div class=\"event-details\">\n                <span class=\"detail-item\">🚶 Guided Walk</span>\n                <span class=\"detail-item\">🌊 River Path</span>\n                <span class=\"detail-item\">🎨 Art Installation</span>\n              </div>\n              <button class=\"cta-button\">Register Now</button>\n            </div>\n          </div>\n        </article>\n\n        <article class=\"event-card sold-out\">\n          <div class=\"sold-out-badge\">SOLD OUT</div>\n          <div class=\"card-image\" style=\"background: linear-gradient(135deg, #e17055 0%, #d63031 100%);\">\n            <div class=\"sold-out-overlay\">\n              <p class=\"sold-out-message\">🎫 This event is sold out</p>\n            </div>\n            <div class=\"card-content\">\n              <h2 class=\"event-title\">Midnight Sold-Out Concert</h2>\n              <p class=\"event-time\">🎤 11:30 PM - 2:00 AM</p>\n              <p class=\"event-description\">\n                The headline act of the night! An electrifying performance featuring\n                world-class artists delivering an unforgettable show. Don't miss out\n                on this spectacular finale to an extraordinary evening.\n              </p>\n              <div class=\"event-details\">\n                <span class=\"detail-item\">🌟 Headliner</span>\n                <span class=\"detail-item\">🔥 Premium Experience</span>\n                <span class=\"detail-item\">🎭 Main Stage</span>\n              </div>\n              <button class=\"cta-button\" disabled>Already Sold Out</button>\n            </div>\n          </div>\n        </article>\n      </div>\n\n      <div class=\"toggle-section\">\n        <button type=\"button\" class=\"show-sold-out-btn\" id=\"showSoldOutBtn\">Show sold out</button>\n      </div>\n    </main>\n\n    <footer>\n      <p>&copy; 2026 Night Garden Events. All rights reserved.</p>\n    </footer>\n  </div>\n\n  <script>\n    document.addEventListener('DOMContentLoaded', function() {\n      const showSoldOutBtn = document.getElementById('showSoldOutBtn');\n      const soldOutCard = document.querySelector('.event-card.sold-out');\n\n      showSoldOutBtn.addEventListener('click', function() {\n        if (soldOutCard) {\n          soldOutCard.classList.remove('hidden');\n        }\n\n        showSoldOutBtn.textContent = 'Hide sold out';\n        showSoldOutBtn.style.borderColor = 'var(--accent-gold)';\n        showSoldOutBtn.style.color = 'var(--accent-gold)';\n        showSoldOutBtn.style.background = 'var(--sold-out-bg)';\n\n        const originalText = 'Show sold out';\n        const revertedText = 'Hide sold out';\n\n        showSoldOutBtn.dataset.originalText = originalText;\n\n        setTimeout(function() {\n          showSoldOutBtn.dataset.revertedText = revertedText;\n        }, 1000);\n      });\n    });\n  </script>\n</body>\n</html>\n"
     }
