        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Night Garden FLEET-3f8f3843c7</title>\n    <style>\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        :root {\n            --bg-dark: #0f0f23;\n            --bg-card: #1a1a3d;\n            --accent-gold: #d4af37;\n            --accent-gold-hover: #f5c542;\n            --text-primary: #ffffff;\n            --text-secondary: #b8b8d8;\n            --text-muted: #7a7a9a;\n            --gradient-1: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            --gradient-2: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);\n            --gradient-3: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);\n            --gradient-sold: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;\n            background: var(--bg-dark);\n            color: var(--text-primary);\n            min-height: 100vh;\n            padding: 2rem 1rem;\n            line-height: 1.6;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        header {\n            text-align: center;\n            margin-bottom: 3rem;\n            padding: 2rem 0;\n        }\n\n        h1 {\n            font-size: clamp(2rem, 5vw, 3rem);\n            font-weight: 700;\n            background: linear-gradient(135deg, var(--accent-gold) 0%, #ffd700 50%, var(--accent-gold) 100%);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            margin: 0;\n            letter-spacing: -0.02em;\n        }\n\n        .subtitle {\n            color: var(--text-secondary);\n            font-size: 1.125rem;\n            margin-top: 0.75rem;\n        }\n\n        .events-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 1.5rem;\n            margin-bottom: 2rem;\n        }\n\n        .event-card {\n            background: var(--bg-card);\n            border-radius: 16px;\n            overflow: hidden;\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            cursor: pointer;\n            border: 1px solid rgba(255, 255, 255, 0.05);\n            display: block;\n        }\n\n        .event-card.hidden {\n            display: none;\n        }\n\n        .event-card:hover:not(.hidden) {\n            transform: translateY(-4px);\n            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);\n        }\n\n        .event-card.sold-out {\n            border: 1px solid var(--accent-gold);\n        }\n\n        .event-card.sold-out::after {\n            content: 'SOLD OUT';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: var(--gradient-sold);\n            opacity: 0.9;\n            z-index: 1;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 700;\n            font-size: 1.5rem;\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n        }\n\n        .event-card-content {\n            position: relative;\n            z-index: 2;\n            padding: 1.75rem;\n        }\n\n        .event-time {\n            display: inline-block;\n            background: rgba(212, 175, 55, 0.2);\n            color: var(--accent-gold);\n            padding: 0.35rem 0.75rem;\n            border-radius: 20px;\n            font-size: 0.875rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n        }\n\n        .event-title {\n            font-size: 1.5rem;\n            font-weight: 700;\n            margin-bottom: 0.75rem;\n            color: var(--text-primary);\n        }\n\n        .event-description {\n            color: var(--text-secondary);\n            font-size: 0.95rem;\n            margin-bottom: 1rem;\n        }\n\n        .event-details {\n            display: flex;\n            flex-direction: column;\n            gap: 0.35rem;\n            color: var(--text-muted);\n            font-size: 0.875rem;\n        }\n\n        .event-details span {\n            display: flex;\n            align-items: center;\n            gap: 0.4rem;\n        }\n\n        .hidden-section {\n            display: none;\n        }\n\n        .reveal-section {\n            display: block;\n            animation: fadeIn 0.5s ease;\n        }\n\n        @keyframes fadeIn {\n            from {\n                opacity: 0;\n                transform: translateY(10px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .reveal-btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            background: var(--gradient-1);\n            color: var(--text-primary);\n            border: none;\n            padding: 1rem 2rem;\n            font-size: 1rem;\n            font-weight: 600;\n            border-radius: 12px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);\n        }\n\n        .reveal-btn:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);\n            background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);\n        }\n\n        .reveal-btn:active {\n            transform: translateY(0);\n        }\n\n        .reveal-btn svg {\n            width: 20px;\n            height: 20px;\n            transition: transform 0.3s ease;\n        }\n\n        .reveal-btn:hover svg {\n            transform: translateX(4px);\n        }\n\n        footer {\n            text-align: center;\n            margin-top: 3rem;\n            padding: 1.5rem 0;\n            color: var(--text-muted);\n            font-size: 0.875rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.05);\n        }\n\n        @media (max-width: 768px) {\n            body {\n                padding: 1.5rem 0.75rem;\n            }\n\n            .events-grid {\n                grid-template-columns: 1fr;\n                gap: 1.25rem;\n            }\n\n            header {\n                padding: 1.5rem 0;\n            }\n        }\n\n        @media (max-width: 375px) {\n            body {\n                padding: 1rem 0.5rem;\n            }\n\n            .event-card-content {\n                padding: 1.25rem;\n            }\n\n            .event-title {\n                font-size: 1.25rem;\n            }\n\n            .reveal-btn {\n                padding: 0.875rem 1.5rem;\n                font-size: 0.9375rem;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>Night Garden FLEET-3f8f3843c7</h1>\n            <p class=\"subtitle\">An unforgettable evening of music, light, and magic</p>\n        </header>\n\n        <main>\n            <div class=\"events-grid\">\n                <article class=\"event-card\" id=\"card-dawn\">\n                    <div class=\"event-card-content\">\n                        <span class=\"event-time\">🌅 6:00 PM - 9:00 PM</span>\n                        <h2 class=\"event-title\">Dawn Jazz</h2>\n                        <p class=\"event-description\">\n                            Experience smooth jazz under the morning sky as talented musicians perform timeless classics and contemporary hits.\n                        </p>\n                        <div class=\"event-details\">\n                            <span>🎷 Live band performance</span>\n                            <span>🎟️ Free admission</span>\n                            <span>📍 Main Plaza</span>\n                        </div>\n                    </div>\n                </article>\n\n                <article class=\"event-card\" id=\"card-lantern\">\n                    <div class=\"event-card-content\">\n                        <span class=\"event-time\">🌙 8:00 PM - 10:00 PM</span>\n                        <h2 class=\"event-title\">River Lantern Walk</h2>\n                        <p class=\"event-description\">\n                            Join us for a serene walk along the riverbank, releasing glowing lanterns into the water while enjoying the peaceful atmosphere.\n                        </p>\n                        <div class=\"event-details\">\n                            <span>🏮 Lantern ceremony</span>\n                            <span>🎫 $15 per person</span>\n                            <span>📍 Riverside Path</span>\n                        </div>\n                    </div>\n                </article>\n\n                <article class=\"event-card hidden sold-out\" id=\"card-midnight\">\n                    <div class=\"event-card-content\">\n                        <span class=\"event-time\" style=\"opacity: 0.6;\">🌃 10:00 PM - 12:00 AM</span>\n                        <h2 class=\"event-title\">Midnight Sold-Out Concert</h2>\n                        <p class=\"event-description\">\n                            The featured headliner performance that sold out in record time. Join us for an incredible live music experience you won't want to miss next year!\n                        </p>\n                        <div class=\"event-details\">\n                            <span>🎤 Featured artist performance</span>\n                            <span>🎫 SOLD OUT</span>\n                            <span>📍 Grand Stage</span>\n                        </div>\n                    </div>\n                </article>\n            </div>\n\n            <div id=\"reveal-section\" class=\"hidden-section\">\n                <article class=\"event-card sold-out\" id=\"card-midnight-full\">\n                    <div class=\"event-card-content\">\n                        <span class=\"event-time\">🌃 10:00 PM - 12:00 AM</span>\n                        <h2 class=\"event-title\">Midnight Sold-Out Concert</h2>\n                        <p class=\"event-description\">\n                            The featured headliner performance that sold out in record time! Experience an incredible live music show with world-class artists.\n                        </p>\n                        <div class=\"event-details\">\n                            <span>🎤 Featured artist performance</span>\n                            <span>🎫 SOLD OUT</span>\n                            <span>📍 Grand Stage</span>\n                        </div>\n                        <p style=\"margin-top: 1rem; color: var(--text-muted); font-style: italic;\">\n                            Stay tuned for next year's lineup!\n                        </p>\n                    </div>\n                </article>\n            </div>\n\n            <div style=\"text-align: center; margin-top: 2rem;\">\n                <button type=\"button\" class=\"reveal-btn\" id=\"reveal-btn\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <polyline points=\"18 15 12 9 6 15\"></polyline>\n                    </svg>\n                    Show sold out\n                </button>\n            </div>\n        </main>\n\n        <footer>\n            <p>&copy; 2026 Night Garden Event Series. All rights reserved.</p>\n        </footer>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            var revealBtn = document.getElementById('reveal-btn');\n            var revealSection = document.getElementById('reveal-section');\n            var midnightCardHidden = document.getElementById('card-midnight');\n\n            revealBtn.addEventListener('click', function() {\n                if (midnightCardHidden.classList.contains('hidden')) {\n                    midnightCardHidden.classList.remove('hidden');\n                    midnightCardHidden.classList.add('reveal-section');\n                    revealSection.style.display = 'block';\n                    revealBtn.style.display = 'none';\n                }\n            });\n        });\n    </script>\n</body>\n</html>\n"
