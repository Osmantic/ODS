{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.ai/schemas/service-manifest.v2.json",
  "title": "ODS Service Manifest v2",
  "type": "object",
  "required": ["schema_version", "compatibility", "service"],
  "properties": {
    "schema_version": {
      "const": "ods.services.v2"
    },
    "compatibility": {
      "type": "object",
      "description": "ODS version compatibility; used by validate-manifests.sh for version checks",
      "properties": {
        "ods_min": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Minimum ODS version this extension supports (e.g. 2.0.0)"
        },
        "ods_max": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Maximum ODS version this extension was tested against (optional)"
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["id", "name", "version", "data_schema_version", "port", "type", "category", "planning"],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": { "host_network": { "const": true } },
                "required": ["host_network"]
              },
              {
                "properties": { "socket_only": { "const": true } },
                "required": ["socket_only"]
              }
            ]
          },
          "then": {},
          "else": { "required": ["port", "health"] }
        },
        {
          "if": {
            "properties": { "socket_only": { "const": true } },
            "required": ["socket_only"]
          },
          "then": {
            "properties": {
              "type": { "const": "host-systemd" },
              "port": { "const": 0 }
            }
          }
        }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "data_schema_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "description": "CLI shorthand aliases for this service"
        },
        "container_name": {
          "type": "string",
          "description": "Docker container name for ods shell"
        },
        "container_uid": {
          "type": "integer",
          "minimum": 1,
          "description": "Numeric UID the container process runs as when it is not visible from compose.user. Used by the host agent to prepare bind-mounted data directories."
        },
        "host_env": { "type": "string" },
        "default_host": { "type": "string" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "external_port_env": { "type": "string" },
        "external_port_default": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "public_url_env": {
          "type": "string",
          "description": "Optional env var that contains the public browser URL for this service when served through an external reverse proxy."
        },
        "host_network": {
          "type": "boolean",
          "description": "True for Docker network_mode: host services that do not declare Docker-mapped ports or HTTP health paths."
        },
        "socket_only": {
          "type": "boolean",
          "description": "True only for host-systemd services whose HTTP-compatible interface is exposed exclusively over a Unix-domain socket and therefore has no TCP port."
        },
        "health": {
          "type": "string",
          "minLength": 0,
          "description": "HTTP health path. Use an empty string for non-HTTP or one-shot services whose readiness is represented by container state/startup_check."
        },
        "health_timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "Health check timeout in seconds (default: 10)"
        },
        "health_source": {
          "type": "string",
          "enum": ["http", "container"],
          "description": "Health authority used by host-side CLI checks. Defaults to http; use container only for internal-only Docker services with a declared Docker healthcheck."
        },
        "ui_path": {
          "type": "string",
          "pattern": "^/.*",
          "description": "Path to the service UI (e.g. /dashboard, /)"
        },
        "external_link": {
          "type": "boolean",
          "description": "When false, omit this service from dashboard external quicklinks while keeping it in health/status APIs."
        },
        "macos_host_supported": {
          "type": "boolean",
          "description": "True when a host-systemd service has an equivalent macOS LaunchAgent and should remain in the Apple service registry."
        },
        "type": { "type": "string", "enum": ["docker", "host-systemd"] },
        "startup_check": {
          "type": "boolean",
          "description": "When false, skip the post-install running-state poll and treat compose's clean exit as success. Set this on one-shot CLI / setup-only extensions whose containers intentionally exit (default: true)."
        },
        "startup_timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "description": "Seconds the host agent polls for the container to reach the running state before declaring install failed (default: 15). Increase for extensions with heavy initialization (e.g. JVM, postgres, clickhouse)."
        },
        "gpu_backends": {
          "type": "array",
          "items": { "type": "string", "enum": ["amd", "nvidia", "apple", "cpu", "none", "all"] },
          "minItems": 1
        },
        "compose_file": {
          "type": "string",
          "description": "Relative path to compose fragment (e.g. compose.yaml)"
        },
        "category": {
          "type": "string",
          "enum": ["core", "recommended", "optional"],
          "description": "core = always on, recommended = enabled by default, optional = user opts in"
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "uniqueItems": true,
          "description": "Service IDs this service depends on"
        },
        "planning": {
          "type": "object",
          "description": "Deterministic, read-only capability planning metadata. It grants no lifecycle authority.",
          "required": [
            "provides",
            "requires",
            "optional",
            "conflicts",
            "provider_priority",
            "requirements",
            "estimates",
            "resources",
            "configuration",
            "artifacts",
            "lifecycle",
            "data",
            "trust",
            "support"
          ],
          "properties": {
            "provides": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}@[1-9][0-9]{0,8}$" },
              "uniqueItems": true
            },
            "requires": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}@[1-9][0-9]{0,8}$" },
              "uniqueItems": true
            },
            "optional": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}@[1-9][0-9]{0,8}$" },
              "uniqueItems": true
            },
            "conflicts": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
              "uniqueItems": true
            },
            "provider_priority": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "requirements": {
              "type": "object",
              "required": ["platforms", "architectures", "container_runtimes", "gpu_backends", "min_driver_version"],
              "properties": {
                "platforms": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["linux", "darwin", "windows"] },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "architectures": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["amd64", "arm64"] },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "container_runtimes": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["docker", "podman", "none"] },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "gpu_backends": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["amd", "nvidia", "apple", "cpu", "none"] },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "min_driver_version": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
                }
              },
              "additionalProperties": false
            },
            "estimates": {
              "type": "object",
              "required": ["download_bytes", "disk_bytes", "cpu_millicores", "ram_bytes", "vram_bytes", "gpu_count"],
              "properties": {
                "download_bytes": { "type": "integer", "minimum": 0 },
                "disk_bytes": { "type": "integer", "minimum": 0 },
                "cpu_millicores": { "type": "integer", "minimum": 0 },
                "ram_bytes": { "type": "integer", "minimum": 0 },
                "vram_bytes": { "type": "integer", "minimum": 0 },
                "gpu_count": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            },
            "resources": {
              "type": "object",
              "required": ["host_ports", "container_ports", "networks", "volumes", "devices", "exclusive", "linux_capabilities", "host_permissions"],
              "properties": {
                "host_ports": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["port", "protocol"],
                    "properties": {
                      "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "protocol": { "type": "string", "enum": ["tcp", "udp"] }
                    },
                    "additionalProperties": false
                  }
                },
                "container_ports": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
                  "uniqueItems": true
                },
                "networks": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^(?!.*\\.\\.)[a-z0-9][a-z0-9._-]{0,63}$" },
                  "uniqueItems": true
                },
                "volumes": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^(?!.*\\.\\.)[a-z0-9][a-z0-9._-]{0,63}$" },
                  "uniqueItems": true
                },
                "devices": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^(?!.*\\.\\.)/[A-Za-z0-9/_-]{1,127}$" },
                  "uniqueItems": true
                },
                "exclusive": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^(?!.*\\.\\.)[a-z0-9][a-z0-9._:-]{0,63}$" },
                  "uniqueItems": true
                },
                "linux_capabilities": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^CAP_[A-Z0-9_]{1,63}$" },
                  "uniqueItems": true
                },
                "host_permissions": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["network", "gpu", "audio", "camera", "usb", "host-mount", "docker-socket", "privileged"] },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "configuration": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "type", "required", "secret", "source", "restart_behavior"],
                "properties": {
                  "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
                  "type": { "type": "string", "enum": ["string", "integer", "boolean", "url", "enum"] },
                  "required": { "type": "boolean" },
                  "secret": { "type": "boolean" },
                  "source": { "type": "string", "enum": ["user", "generated", "system", "provider"] },
                  "restart_behavior": { "type": "string", "enum": ["none", "service", "stack"] },
                  "validation": { "type": "string", "maxLength": 256 },
                  "default": { "type": ["string", "integer", "boolean"] }
                },
                "allOf": [
                  {
                    "if": { "properties": { "secret": { "const": true } }, "required": ["secret"] },
                    "then": { "not": { "required": ["default"] } }
                  }
                ],
                "additionalProperties": false
              }
            },
            "artifacts": {
              "type": "object",
              "required": ["images", "builds"],
              "properties": {
                "images": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["reference", "digest", "download_bytes"],
                    "properties": {
                      "reference": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]{1,511}$" },
                      "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                      "download_bytes": { "type": "integer", "minimum": 0 }
                    },
                    "additionalProperties": false
                  }
                },
                "builds": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["source", "revision", "context_digest", "output", "download_bytes"],
                    "properties": {
                      "source": { "type": "string", "format": "uri" },
                      "revision": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._/-]{0,127}$" },
                      "context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                      "output": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]{1,511}$" },
                      "download_bytes": { "type": "integer", "minimum": 0 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "lifecycle": {
              "type": "object",
              "required": ["health_checks", "readiness", "setup_hook", "migration_hook", "rollback", "timeout_seconds"],
              "properties": {
                "health_checks": { "type": "array", "items": { "type": "string", "maxLength": 256 } },
                "readiness": { "type": "array", "items": { "type": "string", "maxLength": 256 } },
                "setup_hook": { "type": ["string", "null"], "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$" },
                "migration_hook": { "type": ["string", "null"], "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$" },
                "rollback": { "type": "string", "enum": ["definition", "snapshot", "compensating-action", "none"] },
                "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
              },
              "additionalProperties": false
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "backup_class", "owner", "uninstall", "purge"],
                "properties": {
                  "path": { "type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
                  "backup_class": { "type": "string", "enum": ["required", "recommended", "ephemeral"] },
                  "owner": { "type": "string", "enum": ["ods", "extension", "user"] },
                  "uninstall": { "type": "string", "enum": ["preserve", "archive"] },
                  "purge": { "type": "string", "enum": ["separate-approval", "unsupported"] }
                },
                "additionalProperties": false
              }
            },
            "trust": {
              "type": "object",
              "required": ["tier", "publisher", "definition_signature"],
              "properties": {
                "tier": { "type": "string", "enum": ["bundled", "verified", "community", "local"] },
                "publisher": { "type": "string", "minLength": 1, "maxLength": 128 },
                "definition_signature": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9+/=_:.-]{16,1024}$" }
              },
              "additionalProperties": false
            },
            "support": {
              "type": "object",
              "required": ["status", "url"],
              "properties": {
                "status": { "type": "string", "enum": ["supported", "experimental", "deprecated", "unsupported"] },
                "url": { "type": ["string", "null"], "format": "uri" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "env_vars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": { "type": "string" },
              "required": { "type": "boolean" },
              "secret": { "type": "boolean" },
              "description": { "type": "string" },
              "default": { "type": "string" }
            },
            "additionalProperties": false
          },
          "description": "Environment variables used by this service"
        },
        "llm": {
          "type": "object",
          "description": "Declares whether and how this service consumes LLM inference so model swaps can be gated and probed.",
          "required": ["consumes"],
          "properties": {
            "consumes": {
              "type": "boolean",
              "description": "True when this service sends prompts/completions to an LLM endpoint."
            },
            "route": {
              "type": "string",
              "enum": ["gateway", "direct"],
              "description": "gateway routes through the ODS model gateway alias; direct talks to a runtime or app-specific endpoint."
            },
            "pinning": {
              "type": "string",
              "enum": ["none", "dynamic"],
              "description": "none stores no model name; dynamic declares a refresh/reconcile path after swaps."
            },
            "min_context": {
              "type": "integer",
              "minimum": 0,
              "description": "Optional minimum context length required for this app's LLM path."
            },
            "probe": {
              "type": "object",
              "description": "Harness probe descriptor used after every model swap.",
              "properties": {
                "kind": { "type": "string", "enum": ["chat", "completion", "custom"] },
                "path": { "type": "string" },
                "auth": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "consumes": { "const": true } },
                "required": ["consumes"]
              },
              "then": { "required": ["route", "pinning", "probe"] }
            }
          ],
          "additionalProperties": true
        },
        "setup_hook": {
          "type": "string",
          "description": "Relative path to a setup script run during installation (e.g. setup.sh)"
        },
        "hooks": {
          "type": "object",
          "description": "Lifecycle hook scripts. Paths relative to extension directory.",
          "properties": {
            "pre_install": { "type": "string" },
            "post_install": { "type": "string" },
            "pre_start": { "type": "string" },
            "post_start": { "type": "string" },
            "pre_uninstall": { "type": "string" },
            "post_uninstall": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "icon", "category", "requirements", "priority"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "requirements": {
            "type": "object",
            "properties": {
              "services": { "type": "array", "items": { "type": "string" } },
              "services_any": { "type": "array", "items": { "type": "string" } },
              "vram_gb": { "type": "number", "minimum": 0 },
              "vram_mb": { "type": "number", "minimum": 0 },
              "disk_gb": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": true
          },
          "enabled_services_all": { "type": "array", "items": { "type": "string" } },
          "enabled_services_any": { "type": "array", "items": { "type": "string" } },
          "setup_time": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1 },
          "launch": {
            "type": "object",
            "description": "Dashboard feature-card launch target. Use type=service for user-facing service UIs, internal for dashboard routes, and none for backend/API-only features.",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["service", "internal", "none"] },
              "service": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "path": { "type": "string", "pattern": "^/.*" }
            },
            "additionalProperties": false
          },
          "gpu_backends": {
            "type": "array",
            "items": { "type": "string", "enum": ["amd", "nvidia", "apple", "cpu", "none", "all"] },
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "description": "Categorization tags for service discovery"
    }
  },
  "additionalProperties": true
}
