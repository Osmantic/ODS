{
  "name": "Voice Transcription",
  "nodes": [
    {
      "parameters": {
        "content": "## Voice Transcription\n\nPost an audio file, get the transcript back. Runs entirely on your own\nWhisper service \u2014 the audio never leaves the machine.\n\n**Call it:**\n```bash\ncurl -X POST http://localhost:5678/webhook/ods-transcribe \\n  -F 'file=@meeting.wav'\n```\n\nOptional form field `model` (default `Systran/faster-whisper-base`) and\n`language` (ISO code; omit to auto-detect).\n\nThe webhook is set to receive binary data, so the upload is streamed to\nWhisper as multipart rather than being base64'd through JSON.",
        "height": 440,
        "width": 480
      },
      "id": "note-overview",
      "name": "How to use this",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ods-transcribe",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-audio",
      "name": "Audio Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "webhookId": "3e6b8d51-90c7-4a02-b5d4-6a7e1f9c2b58"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $binary?.file?.fileName || $binary?.file?.mimeType }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-audio",
      "name": "Audio Attached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://whisper:8000/v1/audio/transcriptions",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            },
            {
              "name": "model",
              "value": "={{ $json.body?.model || 'Systran/faster-whisper-base' }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "http-whisper",
      "name": "Whisper Transcribe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ text: $json.text, duration: $json.duration, language: $json.language }) }}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Return Transcript",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1220,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: \"Send an audio file as multipart form data, e.g. curl -F 'file=@audio.wav'.\" }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "respond-bad-request",
      "name": "Return 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        420
      ]
    }
  ],
  "connections": {
    "Audio Upload": {
      "main": [
        [
          {
            "node": "Audio Attached?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Audio Attached?": {
      "main": [
        [
          {
            "node": "Whisper Transcribe",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Whisper Transcribe": {
      "main": [
        [
          {
            "node": "Return Transcript",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateId": "voice-transcription"
  },
  "tags": []
}
