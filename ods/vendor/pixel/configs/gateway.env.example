# Copy to ~/.config/pixel-agent/gateway.env with mode 0600.
# OAuth material belongs only to the isolated Source Broker; do not put it here.
OPENCLAW_STATE_DIR=/home/agent/.openclaw
OPENCLAW_CONFIG_PATH=/home/agent/.openclaw/openclaw.json
PIXEL_AGENT_ID=pixel
PIXEL_SOURCE_PROJECTION_DIR=/var/lib/pixel-source-broker/projection
PIXEL_ACTION_PROPOSAL_DIR=/var/lib/pixel-source-broker/proposals
PIXEL_ACTION_RESULT_DIR=/var/lib/pixel-source-broker/results
PIXEL_SOURCE_STALE_AFTER_MS=180000
PIXEL_CALENDAR_DIRECT_ENABLED=1
SEARXNG_BASE_URL=http://127.0.0.1:8890
