{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/historical-secret-review-v2.schema.json",
  "title": "Pixel reviewed historical credential-shaped blobs v2 (strict bound contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "operation",
    "repository",
    "note",
    "reviewedBlobs"
  ],
  "properties": {
    "$schema": {
      "const": "https://osmantic.com/pixel/schemas/historical-secret-review-v2.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "operation": {
      "const": "pixel-historical-secret-review"
    },
    "repository": {
      "const": "Osmantic/Pixel"
    },
    "note": {
      "type": "string",
      "minLength": 40,
      "maxLength": 2000
    },
    "reviewedBlobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blobSha1",
          "payloadSha256",
          "path",
          "labels",
          "auditSourceLabels",
          "reason"
        ],
        "properties": {
          "blobSha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "payloadSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "labels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64
            },
            "uniqueItems": true
          },
          "auditSourceLabels": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 12,
            "maxLength": 600
          }
        }
      }
    }
  }
}
