{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-capability-controller-policy-v2.schema.json",
  "title": "Pixel Deep Work capability controller policy v2 (admission-only foundation)",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "policyId", "createdAt", "expiresAt", "profiles", "packs", "limits", "watchdog", "authority", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-capability-controller-policy-v2.schema.json"},
    "schemaVersion": {"const": 2},
    "policyId": {"type": "string", "pattern": "^workcappolicy-[0-9]{13}-[a-f0-9]{12}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "profiles": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["scout", "builder", "data-lab", "researcher"]}},
    "packs": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "packSha256", "treeSha256", "schemaVersion", "tools", "classifications"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})$"},
          "packSha256": {"$ref": "#/$defs/sha256"},
          "treeSha256": {"$ref": "#/$defs/sha256"},
          "schemaVersion": {"const": 2},
          "tools": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["name", "effectClass", "bindingSummary"], "properties": {"name": {"$ref": "#/$defs/tool"}, "effectClass": {"enum": ["read-only", "workspace", "brokered-network", "external"]}, "bindingSummary": {"$ref": "#/$defs/bindingSummary"}}}},
          "classifications": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted"]}}
        }
      }
    },
    "limits": {"$ref": "#/$defs/limits"},
    "watchdog": {"$ref": "#/$defs/watchdog"},
    "authority": {"const": {"grantsExecution": false, "grantsCredentials": false, "grantsNetwork": false, "grantsExternalEffects": false, "grantsScopeExpansion": false, "grantsCompletion": false}},
    "boundary": {"const": "Admission-only controller allowlist for exact signed v2 capability declarations. Policy alone grants no execution, credential, network, external-effect, scope-expansion, or completion authority; v2 runtime is not enabled."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tool": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "bindingSummary": {"type": "object", "additionalProperties": false, "required": ["targetClass", "inputClassification", "outputClassification"], "properties": {
      "targetClass": {"enum": ["public-api", "private-lan", "local-filesystem", "local-process", "ssh", "browser", "mailbox", "download", "file", "api", "shell"]},
      "inputClassification": {"enum": ["public", "internal", "confidential", "restricted"]},
      "outputClassification": {"enum": ["public", "internal", "confidential", "restricted"]}
    }},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxSessionsPerLease", "maxGrantLifetimeMs", "maxInputBytes", "maxOutputBytes", "maxRuntimeMs", "maxMemoryMiB", "maxCpuCores", "maxPids", "maxWorkspaceBytes"],
      "properties": {
        "maxSessionsPerLease": {"type": "integer", "minimum": 1, "maximum": 4096},
        "maxGrantLifetimeMs": {"type": "integer", "minimum": 100, "maximum": 3600000},
        "maxInputBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "maxRuntimeMs": {"type": "integer", "minimum": 100, "maximum": 3600000},
        "maxMemoryMiB": {"type": "integer", "minimum": 64, "maximum": 8192},
        "maxCpuCores": {"type": "number", "minimum": 0.1, "maximum": 8},
        "maxPids": {"type": "integer", "minimum": 16, "maximum": 512},
        "maxWorkspaceBytes": {"type": "integer", "minimum": 0, "maximum": 34359738368}
      }
    },
    "watchdog": {
      "type": "object", "additionalProperties": false,
      "required": ["maxFailures", "maxRepeatedEquivalent", "maxRepeatedFailure", "maxEventsWithoutVerifiedProgress"],
      "properties": {
        "maxFailures": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxRepeatedEquivalent": {"type": "integer", "minimum": 2, "maximum": 100},
        "maxRepeatedFailure": {"type": "integer", "minimum": 1, "maximum": 100},
        "maxEventsWithoutVerifiedProgress": {"type": "integer", "minimum": 4, "maximum": 1000000}
      }
    }
  }
}
