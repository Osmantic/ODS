{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-goal-draft-v1.schema.json",
  "title": "Pixel Deep Work guided goal draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "operation", "draftId", "createdAt", "goal", "milestones", "bindings", "authority", "nextStep", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-goal-draft-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "operation": {"const": "pixel-work-goal-draft"},
    "draftId": {"type": "string", "pattern": "^workdraft-[0-9]{13}-[a-f0-9]{12}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "dataClassification", "milestones"],
      "properties": {
        "objective": {"type": "string", "minLength": 1, "maxLength": 8000},
        "dataClassification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "milestones": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["milestoneId", "jobId", "profile", "objective", "doneWhen", "dependsOn", "inputIds", "effort", "budgets", "capabilities", "verification", "externalEffects"],
        "properties": {
          "milestoneId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "jobId": {"type": "string", "pattern": "^work-[0-9]{13}-[a-f0-9]{12}$"},
          "profile": {"enum": ["scout", "builder", "researcher", "data-lab"]},
          "objective": {"type": "string", "minLength": 1, "maxLength": 8000},
          "doneWhen": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
          "dependsOn": {"type": "array", "maxItems": 63, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}},
          "inputIds": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}},
          "effort": {"enum": ["quick", "standard", "deep"]},
          "budgets": {"$ref": "#/$defs/budgets"},
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workspace", "tools", "brokeredServices", "modelRoute"],
            "properties": {
              "workspace": {"enum": ["read-only-workspace", "disposable-read-write"]},
              "tools": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}},
              "brokeredServices": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
              "modelRoute": {"const": "local-only"}
            }
          },
          "verification": {"enum": ["independent-report-verification", "patch-integrity-and-semantic-review", "citation-and-source-verification", "isolated-exact-replay-and-semantic-review"]},
          "externalEffects": {"const": false}
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["briefSha256", "policySha256", "inputCatalogSha256", "declarationSha256", "jobsSha256", "inputManifestsSha256"],
      "properties": {
        "briefSha256": {"$ref": "#/$defs/sha256"},
        "policySha256": {"$ref": "#/$defs/sha256"},
        "inputCatalogSha256": {"$ref": "#/$defs/sha256"},
        "declarationSha256": {"$ref": "#/$defs/sha256"},
        "jobsSha256": {"$ref": "#/$defs/sha256"},
        "inputManifestsSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantsExecution", "grantsLease", "grantsRetry", "grantsScheduling", "grantsCredentials", "grantsScopeExpansion", "grantsExternalEffects", "grantsCompletion"],
      "properties": {
        "grantsExecution": {"const": false},
        "grantsLease": {"const": false},
        "grantsRetry": {"const": false},
        "grantsScheduling": {"const": false},
        "grantsCredentials": {"const": false},
        "grantsScopeExpansion": {"const": false},
        "grantsExternalEffects": {"const": false},
        "grantsCompletion": {"const": false}
      }
    },
    "nextStep": {"const": "Review this private draft. Compile its exact jobs and prepare its goal separately; staging and scheduling still require later explicit authority."},
    "boundary": {"const": "Private reviewable long-goal draft only. It derives least-authority local job requests from owner choices and private policy, but grants no execution, lease, retry, scheduling, credential, scope expansion, external effect, or completion authority."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRuntimeSeconds", "maxIterations", "maxToolCalls", "maxConcurrentSubagents", "maxModelRequests", "maxInputTokens", "maxOutputTokens", "maxCpuCores", "maxMemoryMiB", "maxDiskBytes", "maxArtifactBytes", "maxNetworkBytes", "maxFailures", "noProgressLimit"],
      "properties": {
        "maxRuntimeSeconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "maxIterations": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxToolCalls": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxConcurrentSubagents": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxModelRequests": {"type": "integer", "minimum": 1, "maximum": 100000},
        "maxInputTokens": {"type": "integer", "minimum": 1, "maximum": 2000000000},
        "maxOutputTokens": {"type": "integer", "minimum": 1, "maximum": 500000000},
        "maxCpuCores": {"type": "integer", "minimum": 1, "maximum": 128},
        "maxMemoryMiB": {"type": "integer", "minimum": 256, "maximum": 1048576},
        "maxDiskBytes": {"type": "integer", "minimum": 1048576, "maximum": 1099511627776},
        "maxArtifactBytes": {"type": "integer", "minimum": 1, "maximum": 34359738368},
        "maxNetworkBytes": {"type": "integer", "minimum": 0, "maximum": 10737418240},
        "maxFailures": {"type": "integer", "minimum": 1, "maximum": 1000},
        "noProgressLimit": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  }
}
