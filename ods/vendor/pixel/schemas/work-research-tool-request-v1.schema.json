{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-research-tool-request-v1.schema.json",
  "title": "Pixel Researcher tool request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "requestId", "createdAt", "query", "sourceTypes", "domains", "maxResults", "maxSourcesToFetch", "maxSourceBytes", "safeSearch", "egressClassification", "queryDisclosureApproved", "externalEffects", "authority", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-research-tool-request-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "pattern": "^researchtool-[0-9]{13}-[a-f0-9]{32}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "query": {"type": "string", "minLength": 3, "maxLength": 500},
    "sourceTypes": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["web", "news", "academic", "forum"]}},
    "domains": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))+$"}},
    "maxResults": {"type": "integer", "minimum": 1, "maximum": 20},
    "maxSourcesToFetch": {"type": "integer", "minimum": 1, "maximum": 5},
    "maxSourceBytes": {"type": "integer", "minimum": 1024, "maximum": 262144},
    "safeSearch": {"const": "strict"},
    "egressClassification": {"const": "public"},
    "queryDisclosureApproved": {"const": true},
    "externalEffects": {"const": false},
    "authority": {"$ref": "#/$defs/authority"},
    "boundary": {"const": "Untrusted worker request for one public sanitized read-only research operation. The broker independently validates and binds it to the consumed job lease; it grants no direct network, credential, write, account, message, publication, purchase, policy, or scope authority."}
  },
  "$defs": {
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["directNetwork", "credentials", "externalWrites", "accounts", "messages", "publish", "purchase", "policyMutation", "scopeExpansion"],
      "properties": {
        "directNetwork": {"const": false}, "credentials": {"const": false}, "externalWrites": {"const": false},
        "accounts": {"const": false}, "messages": {"const": false}, "publish": {"const": false},
        "purchase": {"const": false}, "policyMutation": {"const": false}, "scopeExpansion": {"const": false}
      }
    }
  }
}
