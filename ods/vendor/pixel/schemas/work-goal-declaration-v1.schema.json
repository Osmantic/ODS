{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-goal-declaration-v1.schema.json",
  "title": "Pixel Deep Work goal declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "objective", "dataClassification", "milestones", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-goal-declaration-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "objective": {"type": "string", "minLength": 1, "maxLength": 8000},
    "dataClassification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "milestones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["milestoneId", "jobId", "dependsOn"],
        "properties": {
          "milestoneId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "jobId": {"type": "string", "pattern": "^work-[0-9]{13}-[a-f0-9]{12}$"},
          "dependsOn": {
            "type": "array",
            "maxItems": 63,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}
          }
        }
      }
    },
    "boundary": {"const": "Owner-authored long-horizon structure only. Preparation may derive immutable hashes and aggregate budgets but grants no execution, lease, retry, credential, scope expansion, external effect, or completion authority."}
  }
}
