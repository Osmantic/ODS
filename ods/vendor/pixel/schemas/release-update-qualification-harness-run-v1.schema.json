{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/release-update-qualification-harness-run-v1.schema.json",
  "title": "Pixel qualification host-run harness receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "operation", "candidateId", "product", "version", "baselineVersion", "relation", "channel", "qualifierIdentity", "sourceCommit", "sourceTree", "host", "envelopeSha256", "stageReceiptSha256", "rehearsalReceiptSha256", "activationReceiptSha256", "activationHash", "claimedAt", "extractedTreeSha256", "rehashedTreeSha256", "rehashedFileCount", "rehashedBytes", "qualificationRootAttestationSha256", "acquiredAt", "candidateCodeCopied", "candidateCodeExecuted", "activeDeploymentChanged", "networkUsed", "terminalPromotionEvidence", "publicationAuthority", "productionActivationAuthority", "compatibilityMutationAuthority", "productionStateChanged", "boundary"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"const": "acquired"},
    "operation": {"const": "pixel-release-qualification-host-run"},
    "candidateId": {"type": "string", "pattern": "^pixel-[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}-[0-9a-f]{64}$"},
    "product": {"const": "Pixel"},
    "version": {"type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"},
    "baselineVersion": {"type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"},
    "relation": {"const": "upgrade"},
    "channel": {"const": "stable"},
    "qualifierIdentity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourceTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "host": {"$ref": "#/$defs/host"},
    "envelopeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stageReceiptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rehearsalReceiptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "activationReceiptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "activationHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claimedAt": {"type": "string", "format": "date-time"},
    "extractedTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rehashedTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rehashedFileCount": {"type": "integer", "minimum": 1, "maximum": 20000},
    "rehashedBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
    "qualificationRootAttestationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acquiredAt": {"type": "string", "format": "date-time"},
    "candidateCodeCopied": {"const": true},
    "candidateCodeExecuted": {"const": false},
    "activeDeploymentChanged": {"const": false},
    "networkUsed": {"const": false},
    "terminalPromotionEvidence": {"const": false},
    "publicationAuthority": {"const": false},
    "productionActivationAuthority": {"const": false},
    "compatibilityMutationAuthority": {"const": false},
    "productionStateChanged": {"const": false},
    "boundary": {"const": "Qualification-root-only private host-run acquisition for one already-claimed activation; candidate programs were not executed, no terminal promotion evidence was produced, and no production state changed."}
  },
  "$defs": {
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "versionId", "label", "supported"],
      "properties": {
        "id": {"enum": ["ubuntu", "debian"]},
        "versionId": {"enum": ["24.04", "12"]},
        "label": {"enum": ["Ubuntu 24.04 LTS", "Debian 12"]},
        "supported": {"const": true}
      },
      "allOf": [
        {"if": {"properties": {"id": {"const": "ubuntu"}}}, "then": {"properties": {"versionId": {"const": "24.04"}, "label": {"const": "Ubuntu 24.04 LTS"}}}},
        {"if": {"properties": {"id": {"const": "debian"}}}, "then": {"properties": {"versionId": {"const": "12"}, "label": {"const": "Debian 12"}}}}
      ]
    }
  }
}
