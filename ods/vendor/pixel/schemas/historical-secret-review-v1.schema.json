{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/historical-secret-review-v1.schema.json",
  "title": "Pixel reviewed historical credential-shaped blobs v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "operation", "note", "reviewedBlobs"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/historical-secret-review-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "operation": {"const": "pixel-historical-secret-review"},
    "note": {"type": "string", "minLength": 40, "maxLength": 1000},
    "reviewedBlobs": {
      "type": "array", "minItems": 0, "maxItems": 256, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["blobSha1", "path", "labels", "reason"],
        "properties": {
          "blobSha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 400},
          "labels": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 3, "maxLength": 64}},
          "reason": {"type": "string", "minLength": 12, "maxLength": 600}
        }
      }
    }
  }
}
