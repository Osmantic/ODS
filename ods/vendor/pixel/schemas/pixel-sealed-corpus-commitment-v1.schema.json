{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/pixel-sealed-corpus-commitment-v1.schema.json",
  "title": "Pixel content-free sealed held-out corpus commitment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "operation", "batterySchema", "revealSchema", "setIdentity", "tuningTaskCount", "tuningCorpusSha256", "tuningSourceTaskSetSha256", "heldOutTaskCount", "heldOutTaskSetSha256", "heldOutTotalBytes", "revealManifestSha256", "boundary", "authority"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/pixel-sealed-corpus-commitment-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "operation": {"const": "pixel-sealed-corpus-commitment"},
    "batterySchema": {"const": "https://osmantic.com/pixel/schemas/agent-comparison-task-battery-v1.schema.json"},
    "revealSchema": {"const": "https://osmantic.com/pixel/schemas/pixel-sealed-corpus-reveal-v1.schema.json"},
    "setIdentity": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "tuningTaskCount": {"type": "integer", "minimum": 1, "maximum": 500},
    "tuningCorpusSha256": {"$ref": "#/$defs/hash"},
    "tuningSourceTaskSetSha256": {"$ref": "#/$defs/hash"},
    "heldOutTaskCount": {"type": "integer", "minimum": 1, "maximum": 500},
    "heldOutTaskSetSha256": {"$ref": "#/$defs/hash"},
    "heldOutTotalBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
    "revealManifestSha256": {"$ref": "#/$defs/hash"},
    "boundary": {"const": "Content-free sealed held-out corpus commitment only. It cryptographically binds the owner-private reveal manifest and task-set aggregates, bounded counts, total bytes, and schema identity but contains no prompt, workspace, expected reply, verifier command or program, research fixture, rehearsal fixture or action, task id, profile, axis, source, per-task size, or filename, and no semantically reconstructive held-out content. Secrecy derives from owner custody and absolute-root file separation, never from hashing alone."},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["reveal", "tuning", "retuning", "disclosure", "execution", "promotion"],
      "properties": {
        "reveal": {"const": false}, "tuning": {"const": false}, "retuning": {"const": false},
        "disclosure": {"const": false}, "execution": {"const": false}, "promotion": {"const": false}
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
