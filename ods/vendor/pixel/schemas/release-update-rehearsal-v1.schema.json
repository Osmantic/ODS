{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/release-update-rehearsal-v1.schema.json",
  "title": "Pixel release compatibility rehearsal receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "candidateId", "product", "version", "currentVersion", "relation", "channel", "publisherIdentity", "sourceCommit", "sourceTree", "host", "toolchain", "checks", "envelopeSha256", "stageReceiptSha256", "extractedTreeSha256", "extractedFileCount", "extractedBytes", "rehearsedAt", "candidateCodeExtracted", "candidateCodeParsed", "candidateCodeExecuted", "activeDeploymentChanged", "networkUsed", "activationAuthority", "boundary"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["rehearsed", "already-rehearsed"]},
    "candidateId": {"type": "string", "pattern": "^pixel-[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}-[0-9a-f]{64}$"},
    "product": {"const": "Pixel"},
    "version": {"type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"},
    "currentVersion": {"type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"},
    "relation": {"const": "upgrade"},
    "channel": {"const": "stable"},
    "publisherIdentity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourceTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "host": {"$ref": "#/$defs/host"},
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeRequired", "nodeObserved", "nodeCompatible", "pythonRequired", "pythonObserved", "pythonCompatible"],
      "properties": {
        "nodeRequired": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "nodeObserved": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "nodeCompatible": {"const": true},
        "pythonRequired": {"const": ">=3.11"},
        "pythonObserved": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "pythonCompatible": {"const": true}
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["signedBundleRevalidated", "stageRevalidated", "safeExtraction", "hostCompatible", "releaseContract", "jsonDocuments", "shellFiles", "javascriptFiles", "pythonFiles", "syntaxFailures"],
      "properties": {
        "signedBundleRevalidated": {"const": true},
        "stageRevalidated": {"const": true},
        "safeExtraction": {"const": true},
        "hostCompatible": {"const": true},
        "releaseContract": {"const": true},
        "jsonDocuments": {"type": "integer", "minimum": 1, "maximum": 2000},
        "shellFiles": {"type": "integer", "minimum": 0, "maximum": 2000},
        "javascriptFiles": {"type": "integer", "minimum": 0, "maximum": 2000},
        "pythonFiles": {"type": "integer", "minimum": 0, "maximum": 2000},
        "syntaxFailures": {"const": 0}
      }
    },
    "envelopeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stageReceiptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extractedTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extractedFileCount": {"type": "integer", "minimum": 1, "maximum": 20000},
    "extractedBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
    "rehearsedAt": {"type": "string", "format": "date-time"},
    "candidateCodeExtracted": {"const": true},
    "candidateCodeParsed": {"const": true},
    "candidateCodeExecuted": {"const": false},
    "activeDeploymentChanged": {"const": false},
    "networkUsed": {"const": false},
    "activationAuthority": {"const": "external-exact-confirmation-only"},
    "boundary": {"const": "Verified candidate compatibility rehearsal only; candidate programs were not executed and the active deployment was not changed."}
  },
  "$defs": {
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "versionId", "label", "supported"],
      "properties": {
        "id": {"enum": ["ubuntu", "debian"]},
        "versionId": {"enum": ["24.04", "12"]},
        "label": {"enum": ["Ubuntu 24.04 LTS", "Debian 12"]},
        "supported": {"const": true}
      },
      "allOf": [
        {"if": {"properties": {"id": {"const": "ubuntu"}}}, "then": {"properties": {"versionId": {"const": "24.04"}, "label": {"const": "Ubuntu 24.04 LTS"}}}},
        {"if": {"properties": {"id": {"const": "debian"}}}, "then": {"properties": {"versionId": {"const": "12"}, "label": {"const": "Debian 12"}}}}
      ]
    }
  }
}
