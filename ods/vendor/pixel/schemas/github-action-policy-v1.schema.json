{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/github-action-policy-v1.schema.json",
  "title": "Pixel GitHub action policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enabled", "allowedRepositories", "allowedOperations", "maxBodyBytes", "maxReconcilePages", "apiVersion", "boundary"],
  "properties": {
    "schemaVersion": {"const": 1},
    "enabled": {"type": "boolean"},
    "allowedRepositories": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"}},
    "allowedOperations": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["create-issue", "create-pull-request", "comment"]}},
    "maxBodyBytes": {"type": "integer", "minimum": 0, "maximum": 65536},
    "maxReconcilePages": {"type": "integer", "minimum": 1, "maximum": 10},
    "apiVersion": {"const": "2026-03-10"},
    "boundary": {"const": "Owner-private allowlist only. Policy grants no credentials, proposal approval, retries, merges, pushes, branch mutation, or repositories not named here."}
  }
}
