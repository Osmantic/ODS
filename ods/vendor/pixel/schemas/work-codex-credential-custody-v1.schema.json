{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-codex-credential-custody-v1.schema.json",
  "title": "Pixel content-free Codex credential custody inspection v1",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "receiptId", "inspectedAt", "policySha256", "authMode", "custodyMode", "status", "mutableRefresh", "credentialsProjected", "credentialPathProjected", "credentialContentsHashed", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-codex-credential-custody-v1.schema.json"}, "schemaVersion": {"const": 1},
    "receiptId": {"type": "string", "pattern": "^workcodexcustody-[0-9]{13}-[a-f0-9]{12}$"}, "inspectedAt": {"type": "string", "format": "date-time"},
    "policySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "authMode": {"enum": ["chatgpt", "api-key"]},
    "custodyMode": {"enum": ["broker-private-chatgpt-auth-cache", "broker-private-api-key-file"]}, "status": {"const": "available"},
    "mutableRefresh": {"type": "boolean"}, "credentialsProjected": {"const": false}, "credentialPathProjected": {"const": false}, "credentialContentsHashed": {"const": false},
    "boundary": {"const": "Content-free broker-private credential custody evidence only. It exposes no path, owner, account, token, key, cache contents, content hash, provider response, prompt, capsule, tool authority, or external-effect authority."}
  }
}
