{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/portal-user-trial-journey-v1.schema.json",
  "title": "Pixel sanitized portal user-trial regression journeys v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "operation", "sourceTranscriptSha256", "sourceTranscriptBytes", "provenance", "behavioralContract", "journeys", "privacy", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/portal-user-trial-journey-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "operation": {"const": "pixel-portal-user-trial-journeys"},
    "sourceTranscriptSha256": {"$ref": "#/$defs/hash"},
    "sourceTranscriptBytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
    "provenance": {"type": "string", "minLength": 40, "maxLength": 1000},
    "behavioralContract": {
      "type": "array", "minItems": 8, "maxItems": 32, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "rule"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,47}$"},
          "rule": {"type": "string", "minLength": 20, "maxLength": 400}
        }
      }
    },
    "journeys": {
      "type": "array", "minItems": 10, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "taskPattern", "profile", "dataClass", "effectBoundary", "verifiability", "contractAssertions", "safetyGuardrails"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
          "category": {"enum": ["briefing-synthesis", "planning-artifact", "self-critique", "capability-honesty", "guardrail", "deep-research", "conversational-qa", "advisory", "agentic-execution", "external-gate"]},
          "taskPattern": {"type": "string", "minLength": 30, "maxLength": 600},
          "profile": {"enum": ["assistant", "scout", "builder", "researcher", "data-lab", "controller"]},
          "dataClass": {"enum": ["public", "internal", "confidential", "private"]},
          "effectBoundary": {"enum": ["none", "read-only", "local-state-change", "external-write"]},
          "verifiability": {"enum": ["local-deterministic", "live-web-gated", "private-data-gated", "external-gate", "conversational"]},
          "contractAssertions": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,47}$"}},
          "safetyGuardrails": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 5, "maxLength": 200}}
        }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["transcriptContentIncluded", "personalDataIncluded", "sourcePathIncluded"],
      "properties": {
        "transcriptContentIncluded": {"const": false},
        "personalDataIncluded": {"const": false},
        "sourcePathIncluded": {"const": false}
      }
    },
    "boundary": {"const": "Sanitized, content-free record of the user-trial task patterns and behavioral contract only. It binds the private transcript by digest for identity, reproduces none of its private content, and grants no execution, provider, external-effect, publication, or acceptance authority."}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
