{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://osmantic.com/pixel/schemas/work-knowledge-deletion-v1.schema.json",
  "title": "Pixel Deep Work knowledge deletion authorization or tombstone v1", "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "deletionId", "sourceId", "sourceReceiptSha256", "ownerId", "clientId", "issuedAt", "expiresAt", "approved", "approverId", "reasonCode", "deletedAt", "sourceContentSha256", "status", "authority", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-knowledge-deletion-v1.schema.json"}, "schemaVersion": {"const": 1},
    "deletionId": {"type": "string", "pattern": "^workknowledgedelete-[0-9]{13}-[a-f0-9]{12}$"}, "sourceId": {"type": "string", "pattern": "^workknowledgesource-[0-9]{13}-[a-f0-9]{12}$"},
    "sourceReceiptSha256": {"$ref": "#/$defs/sha256"}, "ownerId": {"$ref": "#/$defs/tenant"}, "clientId": {"$ref": "#/$defs/tenant"},
    "issuedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}, "approved": {"const": true}, "approverId": {"$ref": "#/$defs/tenant"},
    "reasonCode": {"enum": ["owner-request", "retention-expired", "source-revoked", "client-removal"]},
    "deletedAt": {"type": ["string", "null"], "format": "date-time"}, "sourceContentSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "status": {"enum": ["authorized", "deleted"]},
    "authority": {"const": {"deleteExactLocalSource": true, "network": false, "externalEffects": false, "scopeExpansion": false, "completion": false}},
    "boundary": {"const": "Explicit expiring authorization or content-free tombstone for deleting one exact encrypted local knowledge source. It grants no cross-source, network, external-effect, scope-expansion, or completion authority."}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "tenant": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}}
}
