{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/release-update-qualification-execution-observation-v1.schema.json",
  "title": "Pixel qualification execution observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "candidateId",
    "outcome",
    "phase",
    "reason",
    "exitCode",
    "signal",
    "timedOut",
    "observedVersion",
    "candidateCodeExecuted",
    "executionObserved",
    "executionSpecSha256",
    "sandbox",
    "networkUsed",
    "containerRemoved",
    "absenceProven",
    "terminalPromotionEvidence",
    "publicationAuthority",
    "productionActivationAuthority",
    "compatibilityMutationAuthority",
    "productionStateChanged",
    "boundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operation": {
      "const": "pixel-release-qualification-execution-observation"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^pixel-[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}-[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "success",
        "failure",
        "timeout",
        "signal",
        "deferred"
      ]
    },
    "phase": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "probe",
            "install",
            "activate",
            "cleanup"
          ]
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "non-zero-exit",
            "candidate-rejected",
            "install-contract-deferred",
            "unsupported-host",
            "harness-error",
            "execution-interrupted"
          ]
        }
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      ]
    },
    "signal": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "SIGTERM",
            "SIGKILL",
            "SIGINT",
            "SIGABRT",
            "SIGHUP",
            "SIGQUIT"
          ]
        }
      ]
    },
    "timedOut": {
      "type": "boolean"
    },
    "observedVersion": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"
        }
      ]
    },
    "candidateCodeExecuted": {
      "const": true
    },
    "executionObserved": {
      "const": true
    },
    "executionSpecSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "imageDigest",
        "containerName",
        "network",
        "capDropAll",
        "noNewPrivileges",
        "readOnlyRoot",
        "uid",
        "gid"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+:[A-Za-z0-9._-]+@sha256:[0-9a-f]{64}$"
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "containerName": {
          "type": "string",
          "pattern": "^pixel-qual-exec-[0-9a-f]{20}$"
        },
        "network": {
          "const": "none"
        },
        "capDropAll": {
          "const": true
        },
        "noNewPrivileges": {
          "const": true
        },
        "readOnlyRoot": {
          "const": true
        },
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "gid": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "networkUsed": {
      "const": false
    },
    "terminalPromotionEvidence": {
      "const": false
    },
    "publicationAuthority": {
      "const": false
    },
    "productionActivationAuthority": {
      "const": false
    },
    "compatibilityMutationAuthority": {
      "const": false
    },
    "productionStateChanged": {
      "const": false
    },
    "boundary": {
      "const": "Content-free disposable-host candidate-execution observation; it is not terminal promotion evidence and grants no production, publication, compatibility, or promotion authority."
    },
    "containerRemoved": {
      "const": true
    },
    "absenceProven": {
      "const": true
    }
  }
}
