{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-scout-verification-v1.schema.json",
  "title": "Pixel deterministic Scout evidence verification v1",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "verificationId", "jobId", "claimId", "createdAt", "planSha256", "workspaceSha256", "reportSha256", "status", "verificationLevel", "semanticEntailmentVerified", "independent", "network", "modelUsed", "findings", "privateDataIncluded", "externalEffects", "authority", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-scout-verification-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "verificationId": {"type": "string", "pattern": "^scoutverification-[0-9]{13}-[a-f0-9]{12}$"},
    "jobId": {"type": "string", "pattern": "^work-[0-9]{13}-[a-f0-9]{12}$"},
    "claimId": {"type": "string", "pattern": "^workclaim-[0-9]{13}-[a-f0-9]{12}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "planSha256": {"$ref": "#/$defs/sha256"},
    "workspaceSha256": {"$ref": "#/$defs/sha256"},
    "reportSha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "evidence-pass"},
    "verificationLevel": {"const": "deterministic-local-evidence-presence"},
    "semanticEntailmentVerified": {"const": false},
    "independent": {"const": true},
    "network": {"const": "none"},
    "modelUsed": {"const": false},
    "findings": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["findingId", "status", "evidence"],
        "properties": {
          "findingId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "status": {"const": "pass"},
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["inputId", "path", "quoteSha256", "fileSha256", "offset", "bytes", "status"],
              "properties": {
                "inputId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
                "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[A-Za-z0-9._+/-]+$"},
                "quoteSha256": {"$ref": "#/$defs/sha256"}, "fileSha256": {"$ref": "#/$defs/sha256"},
                "offset": {"type": "integer", "minimum": 0, "maximum": 4294967296},
                "bytes": {"type": "integer", "minimum": 1, "maximum": 65536}, "status": {"const": "present"}
              }
            }
          }
        }
      }
    },
    "privateDataIncluded": {"type": "boolean"}, "externalEffects": {"const": false},
    "authority": {"$ref": "#/$defs/authority"},
    "boundary": {"const": "Independent networkless proof of exact local evidence presence only. It grants no semantic truth, completion, execution, publication, merge, deployment, policy, or scope authority."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["hostAccess", "credentials", "network", "externalEffects", "publish", "merge", "deploy", "policyMutation", "scopeExpansion"],
      "properties": {
        "hostAccess": {"const": false}, "credentials": {"const": false}, "network": {"const": false},
        "externalEffects": {"const": false}, "publish": {"const": false}, "merge": {"const": false},
        "deploy": {"const": false}, "policyMutation": {"const": false}, "scopeExpansion": {"const": false}
      }
    }
  }
}
