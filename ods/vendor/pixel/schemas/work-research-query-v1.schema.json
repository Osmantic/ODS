{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-research-query-v1.schema.json",
  "title": "Pixel public research query v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "queryId", "jobId", "claimId", "createdAt", "planSha256", "leaseSha256", "researchPolicySha256", "query", "sourceTypes", "domains", "maxResults", "safeSearch", "egressClassification", "queryDisclosureApproved", "externalEffects", "authority", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-research-query-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "queryId": {"type": "string", "pattern": "^researchquery-[0-9]{13}-[a-f0-9]{12}$"},
    "jobId": {"type": "string", "pattern": "^work-[0-9]{13}-[a-f0-9]{12}$"},
    "claimId": {"type": "string", "pattern": "^workclaim-[0-9]{13}-[a-f0-9]{12}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "planSha256": {"$ref": "#/$defs/sha256"},
    "leaseSha256": {"$ref": "#/$defs/sha256"},
    "researchPolicySha256": {"$ref": "#/$defs/sha256"},
    "query": {"type": "string", "minLength": 3, "maxLength": 500},
    "sourceTypes": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["web", "news", "academic", "forum"]}},
    "domains": {"$ref": "#/$defs/domains"},
    "maxResults": {"type": "integer", "minimum": 1, "maximum": 20},
    "safeSearch": {"const": "strict"},
    "egressClassification": {"const": "public"},
    "queryDisclosureApproved": {"const": true},
    "externalEffects": {"const": false},
    "authority": {"$ref": "#/$defs/authority"},
    "boundary": {"const": "One public sanitized read-only search query. It may disclose only this exact query to the research broker and grants no direct-network, credential, write, account, publication, purchase, message, policy, or scope authority."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "domains": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))+$"}},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["directNetwork", "credentials", "externalWrites", "accounts", "messages", "publish", "purchase", "policyMutation", "scopeExpansion"],
      "properties": {
        "directNetwork": {"const": false}, "credentials": {"const": false}, "externalWrites": {"const": false},
        "accounts": {"const": false}, "messages": {"const": false}, "publish": {"const": false},
        "purchase": {"const": false}, "policyMutation": {"const": false}, "scopeExpansion": {"const": false}
      }
    }
  }
}
