{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-input-catalog-v1.schema.json",
  "title": "Pixel Deep Work private input catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "catalogId", "createdAt", "entries", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-input-catalog-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "catalogId": {"type": "string", "pattern": "^inputcatalog-[0-9]{13}-[a-f0-9]{12}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "objectName", "contentSha256", "bytes", "classification", "mountMode"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "kind": {"enum": ["repository-snapshot", "dataset", "document", "context"]},
          "objectName": {"type": "string", "pattern": "^[a-f0-9]{64}\\.tar$"},
          "contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
          "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
          "mountMode": {"const": "read-only"},
          "datasets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["datasetId", "relativePath", "format", "contentSha256", "bytes"],
              "properties": {
                "datasetId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
                "relativePath": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,255}(?:/[A-Za-z0-9._-]{1,255})*$"},
                "format": {"enum": ["csv", "json", "jsonl", "parquet", "sqlite"]},
                "contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "dataset"}}, "required": ["kind"]},
            "then": {"required": ["datasets"]},
            "else": {"not": {"required": ["datasets"]}}
          }
        ]
      }
    },
    "boundary": {"const": "Owner-selected content-addressed local input references only. The catalog grants no read, execution, lease, network, credential, external-effect, scope-expansion, or completion authority."}
  }
}
