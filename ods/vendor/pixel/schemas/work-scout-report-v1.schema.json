{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-scout-report-v1.schema.json",
  "title": "Pixel retained Scout report v1",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "reportId", "jobId", "claimId", "createdAt", "planSha256", "workspaceSha256", "titleBase64", "findings", "limitationsBase64", "dataClassification", "privateDataIncluded", "externalEffects", "authority", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-scout-report-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "reportId": {"type": "string", "pattern": "^scoutreport-[0-9]{13}-[a-f0-9]{12}$"},
    "jobId": {"type": "string", "pattern": "^work-[0-9]{13}-[a-f0-9]{12}$"},
    "claimId": {"type": "string", "pattern": "^workclaim-[0-9]{13}-[a-f0-9]{12}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "planSha256": {"$ref": "#/$defs/sha256"},
    "workspaceSha256": {"$ref": "#/$defs/sha256"},
    "titleBase64": {"$ref": "#/$defs/base64"},
    "findings": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["findingId", "statementBase64", "material", "evidence"],
        "properties": {
          "findingId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "statementBase64": {"$ref": "#/$defs/base64"},
          "material": {"type": "boolean"},
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["inputId", "path", "quoteBase64", "quoteSha256", "fileSha256", "offset", "bytes"],
              "properties": {
                "inputId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
                "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[A-Za-z0-9._+/-]+$"},
                "quoteBase64": {"$ref": "#/$defs/base64"},
                "quoteSha256": {"$ref": "#/$defs/sha256"},
                "fileSha256": {"$ref": "#/$defs/sha256"},
                "offset": {"type": "integer", "minimum": 0, "maximum": 4294967296},
                "bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
              }
            }
          }
        }
      }
    },
    "limitationsBase64": {"$ref": "#/$defs/base64"},
    "dataClassification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "privateDataIncluded": {"type": "boolean"},
    "externalEffects": {"const": false},
    "authority": {"$ref": "#/$defs/authority"},
    "boundary": {"const": "Retained local Scout findings with controller-verified exact file evidence. Evidence presence does not establish semantic entailment, completeness, truth, or completion authority."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base64": {"type": "string", "minLength": 4, "maxLength": 87384, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["hostAccess", "credentials", "network", "externalEffects", "publish", "merge", "deploy", "policyMutation", "scopeExpansion"],
      "properties": {
        "hostAccess": {"const": false}, "credentials": {"const": false}, "network": {"const": false},
        "externalEffects": {"const": false}, "publish": {"const": false}, "merge": {"const": false},
        "deploy": {"const": false}, "policyMutation": {"const": false}, "scopeExpansion": {"const": false}
      }
    }
  }
}
