{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-codex-request-v1.schema.json",
  "title": "Pixel private Codex work-provider request v1",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "requestId", "createdAt", "expiresAt", "jobId", "checkpointSha256", "ownerId", "clientId", "taskClass", "egressMode", "classification", "dataCategories", "localAttempt", "objective", "constraints", "acceptanceCriteria", "sensitiveTerms", "documents", "maxOutputTokens", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-codex-request-v1.schema.json"}, "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "pattern": "^workcodexrequest-[0-9]{13}-[a-f0-9]{12}$"},
    "createdAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"},
    "jobId": {"type": "string", "pattern": "^work-[0-9]{13}-[a-f0-9]{12}$"}, "checkpointSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ownerId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}, "clientId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "taskClass": {"enum": ["structural-review", "patch-proposal", "failure-triage"]}, "egressMode": {"enum": ["structural-only", "owner-authorized-content"]},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "dataCategories": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["structural", "source-derived", "personal-identifiers", "customer-confidential", "proprietary-code", "security-findings", "credentials", "private-keys", "session-tokens", "authentication-material", "raw-source-bodies", "regulated-records"]}},
    "localAttempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts", "outcome", "reasonCodes", "receiptSha256"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1, "maximum": 100},
        "outcome": {"enum": ["completed-sufficient", "completed-needs-review", "failed-after-retries", "capability-unavailable", "policy-required-review"]},
        "reasonCodes": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["local-sufficient", "quality-check", "uncertainty", "complexity", "capability-gap", "repeated-failure", "safety-review", "security-review"]}},
        "receiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "objective": {"type": "string", "minLength": 3, "maxLength": 8000},
    "constraints": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 4000}},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "sensitiveTerms": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"enum": ["person", "organization", "customer", "project", "hostname", "identifier"]}, "value": {"type": "string", "minLength": 3, "maxLength": 256}}}},
    "documents": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/document"}},
    "maxOutputTokens": {"type": "integer", "minimum": 64, "maximum": 32768},
    "boundary": {"const": "Private local request for one sanitized Codex work proposal. Compilation does not authorize or invoke a provider, expose credentials, or grant any external effect."}
  },
  "$defs": {
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["documentId", "kind", "language", "content", "contentSha256"],
      "properties": {
        "documentId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "kind": {"enum": ["structure", "interface", "patch-outline", "code-source", "diff", "test-failure", "build-log", "spec", "schema"]},
        "language": {"enum": ["text", "plaintext", "markdown", "json", "jsonl", "yaml", "toml", "csv", "tsv", "javascript", "typescript", "jsx", "tsx", "python", "rust", "go", "java", "kotlin", "swift", "c", "cpp", "csharp", "ruby", "php", "shell", "bash", "powershell", "sql", "html", "css", "xml", "protobuf", "terraform", "hcl", "dockerfile", "makefile", "diff"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 262144}, "contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
