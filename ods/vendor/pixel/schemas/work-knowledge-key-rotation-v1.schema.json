{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-knowledge-key-rotation-v1.schema.json",
  "title": "Pixel Deep Work knowledge-vault key rotation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "rotationId", "vaultId", "rotatedAt", "oldKeyCheckSha256", "newKeyCheckSha256", "sources", "state", "authority", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-knowledge-key-rotation-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "rotationId": {"type": "string", "pattern": "^workknowledgekeyrotation-[0-9]{13}-[a-f0-9]{12}$"},
    "vaultId": {"type": "string", "pattern": "^knowledgevault-[a-f0-9]{12}$"},
    "rotatedAt": {"type": "string", "format": "date-time"},
    "oldKeyCheckSha256": {"$ref": "#/$defs/sha256"},
    "newKeyCheckSha256": {"$ref": "#/$defs/sha256"},
    "sources": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "clientId", "beforeReceiptSha256", "afterReceiptSha256"],
        "properties": {
          "sourceId": {"type": "string", "pattern": "^workknowledgesource-[0-9]{13}-[a-f0-9]{12}$"},
          "clientId": {"$ref": "#/$defs/tenant"},
          "beforeReceiptSha256": {"$ref": "#/$defs/sha256"},
          "afterReceiptSha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "state": {"const": "committed"},
    "authority": {"const": {"localKeyRotation": true, "network": false, "externalEffects": false, "scopeExpansion": false, "completion": false}},
    "boundary": {"const": "Content-free receipt for one atomic local knowledge-vault key rotation. It contains no key or plaintext and grants no network, cross-vault, external-effect, scope-expansion, or completion authority."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tenant": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}
  }
}
