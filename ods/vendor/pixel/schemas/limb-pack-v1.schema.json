{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/limb-pack-v1.schema.json",
  "title": "Pixel declarative limb pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "id", "version", "name", "description", "compatibility", "tools", "authority", "service", "retention", "extensions", "migrations"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/limb-pack-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "projection-limb"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,17}$", "not": {"pattern": "^(limb|gmail|calendar|social|ops|frontier)(-|$)"}},
    "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pixelMajor", "minimumPixel", "minimumOpenClawPluginApi"],
      "properties": {
        "pixelMajor": {"const": 3},
        "minimumPixel": {"type": "string", "pattern": "^3\\.(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})$"},
        "minimumOpenClawPluginApi": {"const": "2026.5.17"}
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "projection", "maxBytes"],
        "properties": {
          "name": {"type": "string", "pattern": "^pixel_[a-z0-9_]{2,63}$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "projection": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}\\.json$"},
          "maxBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "service"],
      "properties": {
        "gateway": {"$ref": "#/$defs/gatewayAuthority"},
        "service": {"$ref": "#/$defs/serviceAuthority"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "entrypoint", "stateDirectory", "scheduleSeconds"],
      "properties": {
        "identity": {"type": "string", "pattern": "^pixel-limb-[a-z][a-z0-9-]{1,17}$"},
        "entrypoint": {"const": "service/service.py"},
        "stateDirectory": {"type": "string", "pattern": "^pixel-limb-[a-z][a-z0-9-]{1,17}$"},
        "scheduleSeconds": {"type": "integer", "minimum": 60, "maximum": 86400}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectionDays", "rawContentStored"],
      "properties": {
        "projectionDays": {"type": "integer", "minimum": 1, "maximum": 365},
        "rawContentStored": {"const": false}
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localCapabilities", "operationsActionPacks", "frontierTaskPacks"],
      "properties": {
        "localCapabilities": {"$ref": "#/$defs/policyPackPaths"},
        "operationsActionPacks": {"$ref": "#/$defs/policyPackPaths"},
        "frontierTaskPacks": {"$ref": "#/$defs/policyPackPaths"}
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromVersions", "stateSchemaVersion"],
      "properties": {
        "fromVersions": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})$"}},
        "stateSchemaVersion": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    }
  },
  "$defs": {
    "policyPackPaths": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^packs/[a-z][a-z0-9-]{0,62}\\.json$"}
    },
    "gatewayAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "networkDestinations", "filesystemRead", "filesystemWrite", "credentials"],
      "properties": {
        "network": {"const": "none"},
        "networkDestinations": {"const": []},
        "filesystemRead": {"const": ["projection", "pack"]},
        "filesystemWrite": {"const": []},
        "credentials": {"const": []}
      }
    },
    "serviceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "networkDestinations", "filesystemRead", "filesystemWrite", "credentials"],
      "properties": {
        "network": {"const": "none"},
        "networkDestinations": {"const": []},
        "filesystemRead": {"const": ["pack", "projection"]},
        "filesystemWrite": {"const": ["projection"]},
        "credentials": {"const": []}
      }
    }
  }
}
