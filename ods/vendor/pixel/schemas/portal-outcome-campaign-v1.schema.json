{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/portal-outcome-campaign-v1.schema.json",
  "title": "Pixel content-free complete paired outcome campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "campaignId", "corpusSha256", "comparatorSha256", "planSha256", "runtimeCondition", "evidenceCutoffAt", "status", "requiredJourneys", "coveredJourneys", "requiredScenarios", "coveredScenarios", "laneHarnessContracts", "comparisons", "summary", "autonomy", "privacy", "boundary"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"const": "pixel-portal-outcome-campaign"},
    "campaignId": {"type": "string", "pattern": "^outcomecampaign-[a-f0-9]{24}$"},
    "corpusSha256": {"$ref": "#/$defs/hash"},
    "comparatorSha256": {"$ref": "#/$defs/hash"},
    "planSha256": {"$ref": "#/$defs/hash"},
    "runtimeCondition": {"enum": ["cold-first-request", "warm-neutral-probe"]},
    "evidenceCutoffAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "blocked"]},
    "requiredJourneys": {"type": "integer", "minimum": 1, "maximum": 64},
    "coveredJourneys": {"type": "integer", "minimum": 0, "maximum": 64},
    "requiredScenarios": {"type": "integer", "minimum": 1, "maximum": 256},
    "coveredScenarios": {"type": "integer", "minimum": 0, "maximum": 256},
    "laneHarnessContracts": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["comparisonLane", "pixelHarnessContractSha256", "codexHarnessContractSha256"],
        "properties": {
          "comparisonLane": {"enum": ["product-default", "same-model-harness"]},
          "pixelHarnessContractSha256": {"$ref": "#/$defs/hash"},
          "codexHarnessContractSha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "comparisons": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["journeyId", "comparisonLane", "runtimeCondition", "scenarioKind", "scenarioFault", "scenarioSeedSha256", "taskAdmissionSha256", "taskBindingSha256", "comparisonSha256", "status", "classification"],
        "properties": {
          "journeyId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
          "comparisonLane": {"enum": ["product-default", "same-model-harness"]},
          "runtimeCondition": {"enum": ["cold-first-request", "warm-neutral-probe"]},
          "scenarioKind": {"enum": ["baseline", "fault-injection"]},
          "scenarioFault": {"oneOf": [{"type": "null"}, {"enum": ["stale-memory", "source-unavailable", "prompt-injection", "malformed-output", "process-crash", "service-restart", "timeout-before-submit", "timeout-after-submit", "eventual-consistency", "duplicate-request", "scope-expansion", "secret-canary", "cross-client-probe", "mock-backend", "self-grade", "artifact-substitution"]}]},
          "scenarioSeedSha256": {"$ref": "#/$defs/hash"},
          "taskAdmissionSha256": {"$ref": "#/$defs/hash"},
          "taskBindingSha256": {"$ref": "#/$defs/hash"},
          "comparisonSha256": {"$ref": "#/$defs/hash"},
          "status": {"enum": ["pass", "blocked"]},
          "classification": {"enum": ["parity", "pixel-regression", "capability-blocking", "reference-failure", "unexplained-delta", "safety-failure"]}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["pass", "blocked", "parity", "pixelRegression", "capabilityBlocking", "referenceFailure", "unexplainedDelta", "safetyFailure"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0, "maximum": 256},
        "blocked": {"type": "integer", "minimum": 0, "maximum": 256},
        "parity": {"type": "integer", "minimum": 0, "maximum": 256},
        "pixelRegression": {"type": "integer", "minimum": 0, "maximum": 256},
        "capabilityBlocking": {"type": "integer", "minimum": 0, "maximum": 256},
        "referenceFailure": {"type": "integer", "minimum": 0, "maximum": 256},
        "unexplainedDelta": {"type": "integer", "minimum": 0, "maximum": 256},
        "safetyFailure": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "autonomy": {
      "type": "object", "additionalProperties": false,
      "required": ["singleAdmissionNoninteractive", "pixelToolCalls", "codexToolCalls", "pixelOperatorInterventions", "codexOperatorInterventions", "pixelExcessOperatorInterventions", "codexExcessOperatorInterventions", "pixelOperatorAttentionRequests", "codexOperatorAttentionRequests", "pixelExcessOperatorAttentionRequests", "codexExcessOperatorAttentionRequests", "pixelApprovalRequests", "codexApprovalRequests", "pixelScopeExpansionRequests", "codexScopeExpansionRequests", "pixelUnnecessarySafetyBlocks", "codexUnnecessarySafetyBlocks"],
      "properties": {
        "singleAdmissionNoninteractive": {"const": true},
        "pixelToolCalls": {"type": "integer", "minimum": 0, "maximum": 256000000000},
        "codexToolCalls": {"type": "integer", "minimum": 0, "maximum": 256000000000},
        "pixelOperatorInterventions": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "codexOperatorInterventions": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "pixelExcessOperatorInterventions": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "codexExcessOperatorInterventions": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "pixelOperatorAttentionRequests": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "codexOperatorAttentionRequests": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "pixelExcessOperatorAttentionRequests": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "codexExcessOperatorAttentionRequests": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "pixelApprovalRequests": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "codexApprovalRequests": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "pixelScopeExpansionRequests": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "codexScopeExpansionRequests": {"type": "integer", "minimum": 0, "maximum": 256000000},
        "pixelUnnecessarySafetyBlocks": {"type": "integer", "minimum": 0, "maximum": 256},
        "codexUnnecessarySafetyBlocks": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["pathsIncluded", "privateContentIncluded", "backendIdentityIncluded", "providerContentIncluded", "credentialsIncluded"],
      "properties": {
        "pathsIncluded": {"const": false}, "privateContentIncluded": {"const": false},
        "backendIdentityIncluded": {"const": false}, "providerContentIncluded": {"const": false},
        "credentialsIncluded": {"const": false}
      }
    },
    "boundary": {"const": "Content-free complete-campaign index only; private plans, run evidence, and reviewer identity remain in separately protected owner custody. This record grants no capability, effect, acceptance, publication, deployment, or promotion authority."}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]}, "then": {"properties": {"summary": {"properties": {"blocked": {"const": 0}, "pixelRegression": {"const": 0}, "capabilityBlocking": {"const": 0}, "referenceFailure": {"const": 0}, "unexplainedDelta": {"const": 0}, "safetyFailure": {"const": 0}}}, "autonomy": {"properties": {"pixelExcessOperatorInterventions": {"const": 0}, "codexExcessOperatorInterventions": {"const": 0}, "pixelExcessOperatorAttentionRequests": {"const": 0}, "codexExcessOperatorAttentionRequests": {"const": 0}, "pixelUnnecessarySafetyBlocks": {"const": 0}, "codexUnnecessarySafetyBlocks": {"const": 0}}}}}}
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
