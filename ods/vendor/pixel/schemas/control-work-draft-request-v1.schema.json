{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/control-work-draft-request-v1.schema.json",
  "title": "Pixel local Deep Work browser draft request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "authoringRevision", "objective", "dataClassification", "milestones"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "deep-work-draft"},
    "authoringRevision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chatTaskHandle": {"type": "string", "pattern": "^chattask-[a-f0-9]{24}$"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "dataClassification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "milestones": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "objective", "doneWhen", "inputHandles", "effort"],
        "properties": {
          "kind": {"enum": ["inspect", "build", "research", "analyze-data"]},
          "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
          "doneWhen": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "dependsOn": {"type": "array", "maxItems": 15, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 15}},
          "inputHandles": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^workinput-[a-f0-9]{24}$"}},
          "effort": {"enum": ["quick", "standard", "deep"]},
          "research": {
            "type": "object", "additionalProperties": false,
            "required": ["allowedDomains", "deniedDomains", "sourceTypes"],
            "properties": {
              "allowedDomains": {"$ref": "#/$defs/domains"},
              "deniedDomains": {"$ref": "#/$defs/domains"},
              "sourceTypes": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["web", "news", "academic", "forum"]}}
            }
          }
        },
        "allOf": [{"if": {"properties": {"kind": {"const": "research"}}, "required": ["kind"]}, "then": {"required": ["research"]}, "else": {"not": {"required": ["research"]}}}]
      }
    }
  },
  "$defs": {
    "domains": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))+$"}}
  }
}
