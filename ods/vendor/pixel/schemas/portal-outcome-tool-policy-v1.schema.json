{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/portal-outcome-tool-policy-v1.schema.json",
  "title": "Pixel backend-neutral outcome tool policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "operation", "workspace", "tools", "brokeredServices", "maximumSubagents", "hostAccess", "ambientCredentials", "externalEffects", "mergeAuthority", "deployAuthority", "policyMutation", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/portal-outcome-tool-policy-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "operation": {"const": "pixel-portal-outcome-tool-policy"},
    "workspace": {"enum": ["read-only", "disposable-read-write"]},
    "tools": {
      "type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true,
      "items": {"enum": ["browser", "calendar-read", "calendar-write", "debug", "edit", "email-read", "eval", "fleet-read", "github-read", "github-write", "hub", "lsp", "public-research", "read", "search", "shell", "task", "write"]}
    },
    "brokeredServices": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {"enum": ["calendar", "email", "fleet", "github", "local-model", "public-research"]}
    },
    "maximumSubagents": {"type": "integer", "minimum": 1, "maximum": 32},
    "hostAccess": {"const": false},
    "ambientCredentials": {"const": false},
    "externalEffects": {"const": false},
    "mergeAuthority": {"const": false},
    "deployAuthority": {"const": false},
    "policyMutation": {"const": false},
    "boundary": {"const": "Backend-neutral least-authority tool envelope for one paired outcome task only. Tools operate only through the declared disposable workspace or typed brokers; this policy grants no host access, ambient credential, external effect, merge, deployment, policy mutation, scope expansion, completion, publication, acceptance, or promotion authority."}
  }
}
