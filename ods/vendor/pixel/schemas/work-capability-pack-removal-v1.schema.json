{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/work-capability-pack-removal-v1.schema.json",
  "title": "Pixel Deep Work capability-pack removal receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "operation", "pack", "signatureSha256", "installationReceiptSha256", "requestedAt", "removedAt", "enabled", "residue", "authority", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/work-capability-pack-removal-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "operation": {"const": "pixel-work-capability-pack-removal"},
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "packSha256", "treeSha256", "signerIdentity"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})\\.(?:0|[1-9][0-9]{0,8})$"},
        "packSha256": {"$ref": "#/$defs/sha256"},
        "treeSha256": {"$ref": "#/$defs/sha256"},
        "signerIdentity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$"}
      }
    },
    "signatureSha256": {"$ref": "#/$defs/sha256"},
    "installationReceiptSha256": {"$ref": "#/$defs/sha256"},
    "requestedAt": {"type": "string", "format": "date-time"},
    "removedAt": {"type": "string", "format": "date-time"},
    "enabled": {"const": false},
    "residue": {
      "const": {
        "installedDeclaration": false,
        "image": false,
        "container": false,
        "workspace": false,
        "controllerRegistration": false
      }
    },
    "authority": {
      "const": {
        "grantsToolUse": false,
        "grantsDataAccess": false,
        "grantsImagePull": false,
        "grantsExecution": false,
        "grantsNetwork": false,
        "grantsExternalEffects": false,
        "grantsCompletion": false
      }
    },
    "boundary": {
      "const": "Content-free tombstone for exact removal of one never-enabled capability declaration. It grants no tool use, data access, image pull, execution, network, external effect, completion, reinstall, or trust authority."
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
