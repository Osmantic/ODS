{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/control-permission-settings-v1.schema.json",
  "title": "Pixel owner-private fixed-action permission settings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "state", "revision", "source", "generatedAt", "settings", "requiresProtectedSave", "privacy", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/control-permission-settings-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "state": {"const": "ready"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {"enum": ["configured", "safe-default", "policy-changed"]},
    "generatedAt": {"type": "string", "format": "date-time"},
    "settings": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"$ref": "#/$defs/setting"}
    },
    "requiresProtectedSave": {"const": true},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathsExposed", "credentialsExposed", "hiddenPolicyExposed"],
      "properties": {
        "pathsExposed": {"const": false},
        "credentialsExposed": {"const": false},
        "hiddenPolicyExposed": {"const": false}
      }
    },
    "boundary": {
      "const": "Owner-private fixed-action permission defaults only. Auto mode can execute only an exact allowlisted action already enabled by the private deployment policy; it cannot add tools, commands, paths, credentials, data routes, budgets, provider egress, or authority."
    }
  },
  "$defs": {
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "mode", "availableModes", "privatePolicyEnabled", "autoEligible"],
      "properties": {
        "kind": {"enum": ["configure", "plan", "verify", "update-check", "backup-create", "operations-pause", "frontier-pause", "deep-work-pause", "deep-work-resume", "deep-work-cancel", "deep-work-draft", "deep-work-prepare", "deep-work-stage", "deep-work-service-render"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "mode": {"enum": ["always-ask", "auto-within-policy", "never-allow"]},
        "availableModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["always-ask", "auto-within-policy", "never-allow"]}
        },
        "privatePolicyEnabled": {"type": "boolean"},
        "autoEligible": {"type": "boolean"}
      }
    }
  }
}
