{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmantic.com/pixel/schemas/control-access-adapter-v1.schema.json",
  "title": "Pixel Cloudflare Access origin adapter configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "listen", "publicOrigin", "upstream", "access", "limits", "boundary"],
  "properties": {
    "$schema": {"const": "https://osmantic.com/pixel/schemas/control-access-adapter-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "listen": {
      "type": "object", "additionalProperties": false, "required": ["host", "port"],
      "properties": {"host": {"const": "127.0.0.1"}, "port": {"type": "integer", "minimum": 1024, "maximum": 65535}}
    },
    "publicOrigin": {"type": "string", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$", "maxLength": 512},
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["origin", "reviewTokenFile"],
      "properties": {
        "origin": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}$", "maxLength": 128},
        "reviewTokenFile": {"type": "string", "pattern": "^/[^\\u0000]+$", "minLength": 2, "maxLength": 4096}
      }
    },
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["teamDomain", "workspaceAudience", "approvalAudience", "allowedEmails", "clockSkewSeconds", "jwksCacheSeconds"],
      "properties": {
        "teamDomain": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.cloudflareaccess\\.com$"},
        "workspaceAudience": {"$ref": "#/$defs/audience"},
        "approvalAudience": {"$ref": "#/$defs/audience"},
        "allowedEmails": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "format": "email", "maxLength": 320}},
        "clockSkewSeconds": {"type": "integer", "minimum": 0, "maximum": 120},
        "jwksCacheSeconds": {"type": "integer", "minimum": 60, "maximum": 86400}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["maxBodyBytes", "requestsPerMinute"],
      "properties": {
        "maxBodyBytes": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "requestsPerMinute": {"type": "integer", "minimum": 10, "maximum": 600}
      }
    },
    "boundary": {"const": "Cloudflare Access-authenticated narrow origin adapter. It validates signed application JWTs and exact audiences before forwarding an allowlisted route to the loopback Pixel control service. Browser cookies, Access assertions, identity claims, credentials, arbitrary paths, and generic commands never cross to the control service. Approval routes require a distinct MFA-enforced Access application audience."}
  },
  "$defs": {"audience": {"type": "string", "pattern": "^[A-Za-z0-9_-]{20,128}$"}}
}
