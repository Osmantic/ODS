ARG SOURCE_DATE_EPOCH=0
FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends xz-utils=5.4.1-1+deb12u1 \
    && rm -rf /var/lib/apt/lists/* /var/cache/* /var/log/*

ADD --checksum=sha256:9749e988f437343b7fa832c69ded82a312e41a03116d766797ac14f6f9eee578 https://nodejs.org/dist/v22.23.1/node-v22.23.1-linux-x64.tar.xz /tmp/node-runtime.tar.xz
RUN install -d -m 0755 /opt/node /opt/pixel/deploy/work-provider/adapters /opt/pixel/deploy/work-provider/profiles /opt/pixel/scripts/lib /opt/pixel/schemas \
    && install -d -m 0700 -o 1000 -g 1000 /run/pixel-policy /run/pixel-credential /state/ledger \
    && tar -xJf /tmp/node-runtime.tar.xz --strip-components=1 -C /opt/node \
    && test "$(/opt/node/bin/node --version)" = "v22.23.1" \
    && rm -f /tmp/node-runtime.tar.xz

COPY --chmod=0444 deploy/work-provider/*.mjs /opt/pixel/deploy/work-provider/
COPY --chmod=0444 deploy/work-provider/adapters/*.mjs /opt/pixel/deploy/work-provider/adapters/
COPY --chmod=0444 deploy/work-provider/profiles/*.json /opt/pixel/deploy/work-provider/profiles/
COPY --chmod=0444 scripts/lib/work-contract.mjs scripts/lib/json-schema.mjs scripts/lib/secure-files.mjs /opt/pixel/scripts/lib/
COPY --chmod=0444 schemas/*.json /opt/pixel/schemas/

RUN printf '%s\n' \
      '3558c5e1ce30823a0bb6d79d2d869f88bef3e698d1563bb12a74329ff6e391b8  /opt/pixel/deploy/work-provider/adapter-contract.mjs' \
      '9237ca1bf318aad5fca5b00adb83ab252857fb17263f2eea73d8926094d7343b  /opt/pixel/deploy/work-provider/adapters/openai-chat.mjs' \
      '942ec2930e53449f2ca5c5c5173c2a4e7c0e827736b522e41bd40f0e4cbc4a83  /opt/pixel/deploy/work-provider/adapters/openai-responses.mjs' \
      '316d457bda89696ab5dfb4d9b9ec41fd9dcea3eabc8ac1aa8a185d2b516d9421  /opt/pixel/deploy/work-provider/credential-custody.mjs' \
      'd2169b8cc4ab8a0aef1035ae2a211ecf8873a8f64cd80e9a5c992c1b7d550459  /opt/pixel/deploy/work-provider/moonshot-transport.mjs' \
      'db2fc5747c8f31c1068d786b407fe977ff51ce9e5ca2e6af3228e10a638c0b23  /opt/pixel/deploy/work-provider/moonshot-smoke-cli.mjs' \
      'ffd612e7b34d43a0c09c57bcce1806135b9fc28f390f87dc4b84b6f9ee5e88cf  /opt/pixel/deploy/work-provider/moonshot-container-entrypoint.mjs' | sha256sum -c - \
    && /opt/node/bin/node --check /opt/pixel/deploy/work-provider/moonshot-container-entrypoint.mjs \
    && find /opt/pixel -type d -exec chmod 0555 {} + \
    && find /opt/pixel -type f -exec chmod 0444 {} +

LABEL org.opencontainers.image.title="Pixel isolated Moonshot work-provider runner" \
      org.opencontainers.image.version="4.3.0-development" \
      org.opencontainers.image.base.name="debian:bookworm-slim" \
      org.osmantic.pixel.node-runtime="22.23.1" \
      org.osmantic.pixel.moonshot-transport-sha256="d2169b8cc4ab8a0aef1035ae2a211ecf8873a8f64cd80e9a5c992c1b7d550459" \
      org.osmantic.pixel.entrypoint-sha256="ffd612e7b34d43a0c09c57bcce1806135b9fc28f390f87dc4b84b6f9ee5e88cf"

USER 1000:1000
ENTRYPOINT ["/opt/node/bin/node", "/opt/pixel/deploy/work-provider/moonshot-container-entrypoint.mjs"]
