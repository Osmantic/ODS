ARG SOURCE_DATE_EPOCH=0
FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends xz-utils=5.4.1-1+deb12u1 \
    && rm -rf /var/lib/apt/lists/* /var/cache/* /var/log/*

ADD --checksum=sha256:9749e988f437343b7fa832c69ded82a312e41a03116d766797ac14f6f9eee578 https://nodejs.org/dist/v22.23.1/node-v22.23.1-linux-x64.tar.xz /tmp/node-runtime.tar.xz
RUN install -d -m 0755 /opt/node /opt/pixel/deploy/work-codex-provider /opt/pixel/scripts/lib /opt/pixel/schemas \
    && tar -xJf /tmp/node-runtime.tar.xz --strip-components=1 -C /opt/node \
    && test "$(/opt/node/bin/node --version)" = "v22.23.1" \
    && rm -f /tmp/node-runtime.tar.xz \
    && groupadd --gid 65532 pixel-egress \
    && useradd --uid 65532 --gid 65532 --no-create-home --no-log-init --home-dir /nonexistent --shell /usr/sbin/nologin pixel-egress \
    && rm -rf /var/cache/* /var/log/*

COPY --chmod=0444 deploy/work-codex-provider/egress-proxy.mjs /opt/pixel/deploy/work-codex-provider/egress-proxy.mjs
COPY --chmod=0444 scripts/lib/work-contract.mjs /opt/pixel/scripts/lib/work-contract.mjs
COPY --chmod=0444 scripts/lib/json-schema.mjs /opt/pixel/scripts/lib/json-schema.mjs
COPY --chmod=0444 schemas/*.json /opt/pixel/schemas/

RUN echo '9d1f4bcb113b3ad47966062ffa6f97a65ce0f93573451e6ec7b0dd63a72601c4  /opt/pixel/deploy/work-codex-provider/egress-proxy.mjs' | sha256sum -c - \
    && /opt/node/bin/node --check /opt/pixel/deploy/work-codex-provider/egress-proxy.mjs \
    && find /opt/pixel -type d -exec chmod 0555 {} + \
    && find /opt/pixel -type f -exec chmod 0444 {} +

LABEL org.opencontainers.image.title="Pixel Codex exact-host egress proxy" \
      org.opencontainers.image.version="4.3.27" \
      org.opencontainers.image.base.name="debian:bookworm-slim" \
      org.osmantic.pixel.node-runtime="22.23.1" \
      org.osmantic.pixel.egress-proxy-sha256="9d1f4bcb113b3ad47966062ffa6f97a65ce0f93573451e6ec7b0dd63a72601c4"

USER 65532:65532
EXPOSE 3128
ENTRYPOINT ["/opt/node/bin/node", "/opt/pixel/deploy/work-codex-provider/egress-proxy.mjs"]
