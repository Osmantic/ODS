# Generated safely by: ./pixel configure
# Shell values containing spaces must stay quoted.
PIXEL_DEPLOYMENT_PROFILE='prepared'
PIXEL_CAPABILITY_PROFILE='chief-of-staff'
PIXEL_RELEASE_VERSION='4.3.27'
PIXEL_OPENCLAW_VERSION='2026.6.33'
PIXEL_DISCORD_PLUGIN_VERSION='2026.6.33'
PIXEL_SEARXNG_PLUGIN_VERSION='2026.6.33'
PIXEL_LLAMA_CPP_PLUGIN_VERSION='2026.6.33'

OPENCLAW_BIN='/home/agent/.npm-global/bin/openclaw'
OPENCLAW_HOME='/home/agent/.openclaw'
PIXEL_INSTALL_DIR='/home/agent/.local/share/pixel'
PIXEL_SYSTEMD_UNIT='openclaw-gateway.service'
PIXEL_GATEWAY_PORT='18789'
PIXEL_AGENT_ID='pixel'
PIXEL_AGENT_NAME='Pixel'
PIXEL_WORKSPACE='/home/agent/.openclaw/workspace-pixel'
PIXEL_PRIVATE_ONBOARDING_PATH='/home/agent/.config/pixel-deployment/onboarding.json'

# Independently deployable capability limbs. Disabled limbs are omitted from Pixel's
# tool surface and their service is not required.
PIXEL_LIMB_EMAIL_ENABLED='1'
PIXEL_LIMB_CALENDAR_ENABLED='1'
PIXEL_LIMB_SOCIAL_ENABLED='0'
PIXEL_LIMB_WEB_ENABLED='1'
PIXEL_LIMB_OPERATIONS_ENABLED='0'
PIXEL_LIMB_FRONTIER_ENABLED='0'

# Host-side, policy-enforced renderer for JavaScript-heavy public pages. The agent's
# Docker sandbox remains networkless and exchanges bounded files through its workspace.
PIXEL_WEB_COURIER_ENABLED='1'
PIXEL_WEB_COURIER_UNIT='pixel-web-courier.service'
PIXEL_COURIER_SYSTEMD_DIR='/etc/systemd/system'
PIXEL_WEB_COURIER_LOG_PATH='/home/agent/.openclaw/logs/web-courier.jsonl'
PIXEL_WEB_COURIER_BROWSER_PATH='/home/agent/.local/share/pixel/browsers'
PIXEL_WEB_COURIER_WHEELHOUSE='/home/agent/.local/share/pixel/bootstrap/web-courier/wheelhouse'
PIXEL_WEB_COURIER_NAV_TIMEOUT_MS='30000'
PIXEL_WEB_COURIER_TEXT_CAP='5242880'
PIXEL_WEB_COURIER_SCREENSHOT_CAP='20971520'
PIXEL_WEB_COURIER_DOMAIN_INTERVAL='3'
PIXEL_WEB_COURIER_ALLOWED_PORTS='80,443'

# OpenAI-compatible model endpoint. Keep real remote API keys in the ignored .env
# or an OpenClaw secret provider; never commit them.
PIXEL_MODEL_PROVIDER='local'
PIXEL_MODEL_ID='assistant-model'
PIXEL_MODEL_NAME='Local Assistant Model'
PIXEL_MODEL_BASE_URL='http://127.0.0.1:8000/v1'
PIXEL_MODEL_API_KEY='local-no-auth'
PIXEL_MODEL_REASONING='1'
PIXEL_MODEL_CONTEXT_WINDOW='131072'
PIXEL_MODEL_MAX_TOKENS='4096'

# Local/private services.
PIXEL_SEARXNG_BASE_URL='http://127.0.0.1:8890'
PIXEL_SEARXNG_IMAGE='docker.io/searxng/searxng:latest@sha256:79c2be18a18367484474bae9b18a8cd9085114ab3dcd49cac091cad8c548a0a9'
PIXEL_EMBEDDING_MODEL='embeddinggemma-300m-qat-Q8_0.gguf'
PIXEL_EMBEDDING_CACHE='/var/lib/openclaw/models/embed-cache'
PIXEL_SANDBOX_IMAGE='openclaw-sandbox:bookworm-slim'

# Optional reference local-model service. Model weights are never stored in Git.
PIXEL_ENABLE_REFERENCE_MODEL='0'
PIXEL_LLAMA_IMAGE='ghcr.io/ggml-org/llama.cpp:server@sha256:8b7f05d7d14d040463ef9191b24da93724574abd6bfea9bf12899100f62e98db'
PIXEL_REFERENCE_MODEL_FILE='/srv/pixel/models/model.gguf'
PIXEL_REFERENCE_MODEL_PORT='8000'

# Google Workspace non-secret settings.
PIXEL_GOOGLE_ACCOUNT='user@example.com'
PIXEL_TIME_ZONE='America/New_York'
PIXEL_CALENDAR_ID='primary'
PIXEL_GOOGLE_CONFIG_DIR='/home/agent/.config/pixel-google-workspace'
PIXEL_GOOGLE_CLIENT_FILE='/home/agent/.config/pixel-google-workspace/client.json'
PIXEL_GOOGLE_TOKEN_PATH='/home/agent/.config/pixel-google-workspace/token.json'
PIXEL_OAUTH_REDIRECT_URI='http://127.0.0.1:8765'

# Isolated one-way source broker. Google credentials are staged at the paths above only
# during authorization, then moved under the dedicated system identity.
PIXEL_SOURCE_BROKER_ENABLED='1'
PIXEL_SOURCE_BROKER_UNIT='pixel-source-broker.service'
PIXEL_SOURCE_BROKER_TIMER='pixel-source-broker.timer'
PIXEL_SOURCE_ACTION_UNIT='pixel-source-action@.service'
PIXEL_SOURCE_RECONCILE_UNIT='pixel-source-reconcile@.service'
PIXEL_SOURCE_DIRECT_UNIT='pixel-source-direct.service'
PIXEL_SOURCE_DIRECT_PATH_UNIT='pixel-source-direct.path'
PIXEL_SOURCE_BROKER_SYSTEMD_DIR='/etc/systemd/system'
PIXEL_SOURCE_BROKER_ENV='/etc/pixel-source-broker.env'
PIXEL_SOURCE_BROKER_INSTALL_DIR='/opt/pixel-source-broker'
PIXEL_SOURCE_BROKER_STATE_DIR='/var/lib/pixel-source-broker'
PIXEL_SOURCE_BROKER_USER='pixel-source-broker'
PIXEL_SOURCE_READER_USER='agent'
PIXEL_SOURCE_TOKEN_PATH='/var/lib/pixel-source-broker/private/google-token.json'
PIXEL_SOURCE_PROJECTION_DIR='/var/lib/pixel-source-broker/projection'
PIXEL_ACTION_PROPOSAL_DIR='/var/lib/pixel-source-broker/proposals'
PIXEL_ACTION_RESULT_DIR='/var/lib/pixel-source-broker/results'
PIXEL_CALENDAR_DIRECT_ENABLED='1'
PIXEL_CALENDAR_DIRECT_MAX_PER_HOUR='20'
PIXEL_SOURCE_GMAIL_QUERY='in:inbox'
PIXEL_SOURCE_GMAIL_PAGE_SIZE='100'
PIXEL_SOURCE_GMAIL_MAX_PAGES='1000'
PIXEL_SOURCE_GMAIL_SENT_QUERY='in:sent'
PIXEL_SOURCE_GMAIL_SENT_PAGE_SIZE='100'
PIXEL_SOURCE_GMAIL_SENT_MAX_PAGES='1000'
PIXEL_SOURCE_CALENDAR_PAST_DAYS='7'
PIXEL_SOURCE_CALENDAR_FUTURE_DAYS='90'
PIXEL_SOURCE_STALE_AFTER_MS='180000'

# Isolated Operations Broker. Customize and store the source policy outside Git.
PIXEL_OPS_BROKER_ENABLED='0'
PIXEL_OPS_BROKER_UNIT='pixel-ops-broker.service'
PIXEL_OPS_BROKER_SYSTEMD_DIR='/etc/systemd/system'
PIXEL_OPS_BROKER_ENV='/etc/pixel-ops-broker.env'
PIXEL_OPS_BROKER_INSTALL_DIR='/opt/pixel-ops-broker'
PIXEL_OPS_BROKER_STATE_DIR='/var/lib/pixel-ops-broker'
PIXEL_OPS_BROKER_USER='pixel-ops-broker'
PIXEL_OPS_BROKER_GROUP='pixel-ops'
PIXEL_OPS_READER_USER='agent'
PIXEL_OPS_POLICY_PATH='/etc/pixel-ops-broker/policy.json'
PIXEL_OPS_STATE_DIR='/var/lib/pixel-ops-broker'
PIXEL_OPS_REQUEST_DIR='/var/lib/pixel-ops-broker/requests'
PIXEL_OPS_RESULT_DIR='/var/lib/pixel-ops-broker/results'
PIXEL_OPS_EVENT_DIR='/var/lib/pixel-ops-broker/events'
PIXEL_OPS_CANCEL_DIR='/var/lib/pixel-ops-broker/cancel'
PIXEL_OPS_INVENTORY_PATH='/var/lib/pixel-ops-broker/inventory.json'

# Isolated Frontier Broker. The gateway can publish typed requests and read bounded
# results, but cannot read the private policy, provider credential, plans, or authority.
PIXEL_FRONTIER_BROKER_ENABLED='0'
PIXEL_FRONTIER_BROKER_UNIT='pixel-frontier-broker.service'
PIXEL_FRONTIER_BROKER_SYSTEMD_DIR='/etc/systemd/system'
PIXEL_FRONTIER_BROKER_ENV='/etc/pixel-frontier-broker.env'
PIXEL_FRONTIER_BROKER_INSTALL_DIR='/opt/pixel-frontier-broker'
PIXEL_FRONTIER_BROKER_STATE_DIR='/var/lib/pixel-frontier-broker'
PIXEL_FRONTIER_BROKER_USER='pixel-frontier-broker'
PIXEL_FRONTIER_BROKER_GROUP='pixel-frontier'
PIXEL_FRONTIER_READER_USER='agent'
PIXEL_FRONTIER_POLICY_PATH='/etc/pixel-frontier-broker/policy.json'
PIXEL_FRONTIER_AUTH_MODE='api-key'
PIXEL_FRONTIER_CREDENTIAL_SOURCE='/secure/client-config/openai-api-key'
PIXEL_FRONTIER_CREDENTIAL_PATH='/var/lib/pixel-frontier-broker/private/provider-key'
PIXEL_FRONTIER_STATE_DIR='/var/lib/pixel-frontier-broker'
PIXEL_FRONTIER_REQUEST_DIR='/var/lib/pixel-frontier-broker/requests'
PIXEL_FRONTIER_RESULT_DIR='/var/lib/pixel-frontier-broker/results'
PIXEL_FRONTIER_EVENT_DIR='/var/lib/pixel-frontier-broker/events'
PIXEL_FRONTIER_CANCEL_DIR='/var/lib/pixel-frontier-broker/cancel'

# Private-state backup authentication. The backup command creates an Ed25519 key
# and matching trust file at these defaults when the variables are blank.
PIXEL_BACKUP_AGE_RECIPIENT=''
PIXEL_BACKUP_SIGNING_KEY=''
PIXEL_BACKUP_ALLOWED_SIGNERS=''

# Safety switches. Plan is always non-mutating. Apply requires --confirm.
PIXEL_SKIP_ENDPOINT_CHECKS='0'
PIXEL_SKIP_NPM_CI='0'
APPLY_CONFIG='0'

# Narrow release operator (optional). When enabled, routine apply/rollback/verify route the
# privileged unit install/remove, systemctl write verbs, and broker permission probes through
# the dedicated forced-command transport identity instead of password-backed sudo. Requires
# one-time root provisioning (see deploy/release-operator/README.md). The owner account never
# receives NOPASSWD sudo. Legacy 3.2.2 migration stays a separate one-time sudo transaction.
# PIXEL_RELEASE_OPERATOR_ENABLED='0'
# PIXEL_RELEASE_OPERATOR_USER='pixel-release-transport'
# PIXEL_RELEASE_OPERATOR_KEY='/home/agent/.config/pixel-deployment/release-operator.key'
