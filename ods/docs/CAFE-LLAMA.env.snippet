# Optional cafe-llama.cpp advanced runtime (does NOT replace llama-server)
# Install the curated recipe first, then set CAFE_LLAMA_ENABLED=true for model activation.
# Docs: docs/CAFE-LLAMA.md
# Schema fragment: extensions/library/services/cafe-llama/env.schema.fragment.json
# Append this block to your install .env / upstream .env.example when enabling cafe-llama.

# CAFE_LLAMA_ENABLED=false
# CAFE_LLAMA_HOST=127.0.0.1
# EXT_CAFE_LLAMA_PORT=8081
# CAFE_LLAMA_PORT=8081
# CAFE_LLAMA_MODEL=  # supplied by the activation agent; leave blank
# CAFE_LLAMA_RELEASE_URL=  # required only for CPU-compatible builds
# CAFE_LLAMA_SERVER=
# CAFE_LLAMA_EXTRA_ARGS=
# LLAMA_ARG_HOST_MOE=
# LLAMA_ARG_N_HOST_MOE=
# LLAMA_ARG_CPU_MOE=
# LLAMA_ARG_N_CPU_MOE=
# LLAMA_ARG_SSD_STREAMING=
# LLAMA_ARG_N_SSD=
# LLAMA_ARG_CACHE_TYPE_K=turbo4
# LLAMA_ARG_CACHE_TYPE_V=turbo4
# LLAMA_ARG_FLASH_ATTN=on
# LLAMA_ARG_SPEC_TYPE=draft-mtp
# LLAMA_ARG_SPEC_DRAFT_N_MAX=4
# LLAMA_ARG_PIPELINE_PARALLEL=
# LLAMA_ARG_NO_NGRAM=
# LLAMA_ARG_NGRAM_SSD=
