  "semantics": {
    "clock": "One Date.now captured once per tool invocation and passed to freshness/window functions. No caller clock.",
    "ownerTimeZone": "Only current api runtime config agents.defaults.userTimezone, validated IANA; no plugin duplicate or host/environment fallback.",
    "calendarTimeZone": "Validated global timeZone of current existing events.list response. Must remain stable across pages/cycle; otherwise producer marks unavailable/inconsistent. Never substitute owner/event/host timezone.",
    "absolute": "Existing strict explicit-offset timestamps; end exclusive; no clipping to projection coverage.",
    "rolling": "[serverNow, serverNow + days*86400000); timezone-independent duration, returned as UTC instants.",
    "civilDays": "[start of today/tomorrow in ownerTimeZone, start plus N civil dates); DST-aware, not N*86400000. Missing owner timezone => unavailable, no exact count.",
    "allDay": "Interpret start.date/end.date in global calendarTimeZone, end exclusive. Missing/invalid/global timezone drift => unresolved, never UTC implicit.",
    "completeCalendar": "Fresh + source sync ok + coverage bounded/complete/no retained records + requested window covered + validated global Calendar TZ + zero unresolved bounds. Otherwise completeMatchCount null; observed counts remain scoped snapshot evidence only.",
    "gmail": "Use same local projected-fields filter and emailCountScope. mailboxTotal always null; no arbitrary coverage/query echo. Complete local query is not entire Gmail.",
    "noRecords": "Closed whitelist output only; no message/event arrays, IDs, names, subjects, summaries, query echo or arbitrary provider/source fields.",
    "scope": "No new endpoint/OAuth scopes, no catalog narrowing, no public release/version/bundle/pin/model/provider calls. Invalid args refused before source read by actual locked TypeBox.",
    "errorHandling": "Count errors never include Error.message/path/JSON fragments/source fields. Closed unavailable output with null counts and fixed limitation codes; invalid schema refuses before any source read.",
    "timestampHandling": "Canonical ISO timestamps only. Missing/invalid/future generatedAt => freshness unknown, ageSeconds null, no complete/absence claim.",
    "legacyCalendarCursor": "pagesFetched>0 without a validated global timezone cannot adopt a later page timezone to certify that cycle. Omission/mismatch latches inconsistent/unknown until the next fresh cycle.",
    "civilMidnight": "Missing/nonexistent/ambiguous local midnight or skipped civil date => window/event unresolved; no normalization, host fallback or silent UTC."
  },
  "supersedesSha256": "9c4071f31806d7dcad100bd0883d8aaaf4fe848998c8900ca8b7e8c23680f3af"
